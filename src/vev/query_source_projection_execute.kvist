(defn q-db-read-source-entity-string-int-triples [source: DB-Read-Source, query: Query, inputs: []Query-Input] -> [columns: Entity-String-Int-Triples, ok: bool, error: string]
  (let [out (empty-entity-string-int-triples)
        seen (set.empty string)]
    (defer (delete seen))
    (when (> (count inputs) 0)
      (return out false ""))
    (let [[plan plan-ok plan-error] (db-read-source-query-entity-two-value-plan source query)]
      (when (not plan-ok)
        (delete plan.filters)
        (return out false plan-error))
      (let [[best-filter-index best-ok best-error] (db-read-source-entity-two-value-plan-best-filter source plan)]
        (when (not best-ok)
          (delete plan.filters)
          (return out false best-error))
        (let [best-filter plan.filters[best-filter-index]
              [stream stream-ok stream-error] (source-attr-value-match-stream source best-filter.attr best-filter.value)]
          (when (not stream-ok)
            (delete plan.filters)
            (return out false stream-error))
          (let [[append-ok type-ok append-error] (source-entity-string-int-triple-append-filter-stream! (addr out) (addr seen) source (addr stream) plan best-filter-index)]
            (when (not append-ok)
              (delete-source-attr-value-match-stream stream)
              (delete plan.filters)
              (return out false append-error))
            (when (not type-ok)
              (delete-source-attr-value-match-stream stream)
              (delete plan.filters)
              (return out false "")))
          (delete-source-attr-value-match-stream stream)))
      (delete plan.filters)
      (return out true ""))))

