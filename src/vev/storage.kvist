(defn sqlite-index-run-manifest-run-bounds-count-for-test [path: string, manifest-id: u64] -> [run-count: int, ok: bool, error: string]
  (let [[handle open-ok open-error] (vev.sqlite-open-live-raw path)]
    (when (not open-ok)
      (return 0 false open-error))
    (let [[roots counts first-entities first-attrs first-values first-txs first-added last-entities last-attrs last-values last-txs last-added bounds-ok bounds-error] (vev.sqlite-index-run-manifest-run-bounds-parts-raw handle manifest-id)]
      (vev.sqlite-close-live-raw handle)
      (defer (delete roots))
      (defer (delete counts))
      (defer (delete first-entities))
      (defer (delete-owned-strings-array first-attrs))
      (defer (delete-owned-strings-array first-values))
      (defer (delete first-txs))
      (defer (delete first-added))
      (defer (delete last-entities))
      (defer (delete-owned-strings-array last-attrs))
      (defer (delete-owned-strings-array last-values))
      (defer (delete last-txs))
      (defer (delete last-added))
      (when (not bounds-ok)
        (return 0 false bounds-error))
      (let [bounds-count (count roots)]
        (when (or (not (= (count counts) bounds-count))
                  (not (= (count first-entities) bounds-count))
                  (not (= (count first-attrs) bounds-count))
                  (not (= (count first-values) bounds-count))
                  (not (= (count first-txs) bounds-count))
                  (not (= (count first-added) bounds-count))
                  (not (= (count last-entities) bounds-count))
                  (not (= (count last-attrs) bounds-count))
                  (not (= (count last-values) bounds-count))
                  (not (= (count last-txs) bounds-count))
                  (not (= (count last-added) bounds-count)))
          (return 0 false "sqlite index run manifest bound columns had mismatched lengths"))
        (return bounds-count true "")))))

(defn sqlite-create-index-run-manifest-for-test [path: string, index-name: string] -> [manifest-id: u64, ok: bool, error: string]
  (let [[handle open-ok open-error] (vev.sqlite-open-live-raw path)]
    (when (not open-ok)
      (return 0 false open-error))
    (let [[basis rows root root-ok root-error] (vev.sqlite-latest-index-root-chunk-info-raw handle index-name)]
      (when (not root-ok)
        (vev.sqlite-close-live-raw handle)
        (return 0 false root-error))
      (let [[created-manifest-id manifest-ok manifest-error] (vev.sqlite-insert-index-run-manifest-raw handle index-name basis root rows 1 basis)]
        (when (not manifest-ok)
          (vev.sqlite-close-live-raw handle)
          (return 0 false manifest-error))
        (let [[run-ok run-error] (vev.sqlite-insert-index-run-manifest-run-raw handle created-manifest-id 0 root rows)]
          (when (not run-ok)
            (vev.sqlite-close-live-raw handle)
            (return 0 false run-error))
          (let [[entity-range-ok entity-range-error] (sqlite-insert-index-run-manifest-entity-attr-ranges-from-root! handle created-manifest-id 0 index-name root)]
            (when (not entity-range-ok)
              (vev.sqlite-close-live-raw handle)
              (return 0 false entity-range-error)))
          (if (sqlite-index-name-has-contiguous-attrs? index-name)
            (let [[range-ok range-error] (sqlite-insert-index-run-manifest-attr-ranges-from-root! handle created-manifest-id 0 root (int rows))]
              (vev.sqlite-close-live-raw handle)
              (return created-manifest-id range-ok range-error))
            (do
              (vev.sqlite-close-live-raw handle)
              (return created-manifest-id true ""))))))))

