        (vev.sqlite-close-live-raw handle)
        (return false root-error))
      (let [[clear-ok clear-error] (vev.sqlite-clear-index-chunk-child-count-raw handle root)]
        (vev.sqlite-close-live-raw handle)
        (return clear-ok clear-error)))))

