  left-filter-value: Value
  output-var: string
  output-attr: string
})

(defstruct Attr-Top-N-Aggregate-Plan {
  attr: string
  value-var: string
})

(defstruct Missing-Attr-Projection-Plan {
  entity-var: string
  value-var: string
  value-attr: string
  missing-attr: string
})

