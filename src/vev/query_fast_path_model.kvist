(defstruct Entity-Int-Pair {
  entity: u64
  value: i64
})

(defstruct Entity-Int-Pair-Columns {
  entities: [dynamic]u64
  values: [dynamic]i64
})

(defstruct Entity-String-Pair-Columns {
  entities: [dynamic]u64
  strings: [dynamic]string
  owns-strings: bool
})

(defstruct String-String-Pair-Columns {
  first: [dynamic]string
  second: [dynamic]string
  owns-strings: bool
})

(defstruct Entity-String-Int-Triples {
  entities: [dynamic]u64
  strings: [dynamic]string
  ints: [dynamic]i64
  owns-strings: bool
})

(defstruct Entity-Int-Pair-Filter {
  attr: string
  value: Value
})

(defstruct Entity-Int-Pair-Plan {
  entity-var: string
  value-var: string
  value-attr: string
  filters: [dynamic]Entity-Int-Pair-Filter
})

(defstruct Entity-Two-Value-Plan {
  entity-var: string
  first-var: string
  first-attr: string
  second-var: string
  second-attr: string
