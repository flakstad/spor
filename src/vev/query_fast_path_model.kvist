(defn empty-entity-int-pair-plan [] -> Entity-Int-Pair-Plan
  (Entity-Int-Pair-Plan {filters: (make [dynamic]Entity-Int-Pair-Filter)}))

(defn empty-entity-int-pair-columns [] -> Entity-Int-Pair-Columns
  (Entity-Int-Pair-Columns {entities: (make [dynamic]u64)
                            values: (make [dynamic]i64)}))

(defn entity-int-pair-columns-with-capacity [capacity: int] -> Entity-Int-Pair-Columns
  (Entity-Int-Pair-Columns {entities: (make [dynamic]u64 0 capacity)
                            values: (make [dynamic]i64 0 capacity)}))

(defn delete-entity-int-pair-columns [columns: Entity-Int-Pair-Columns]
  (delete columns.entities)
  (delete columns.values))

(defn reset-entity-int-pair-columns-capacity! [columns: ^Entity-Int-Pair-Columns, capacity: int]
  (delete columns^.entities)
  (delete columns^.values)
  (set! columns^.entities (make [dynamic]u64 0 capacity))
  (set! columns^.values (make [dynamic]i64 0 capacity)))

(defn append-entity-int-pair-column! [columns: ^Entity-Int-Pair-Columns, entity: u64, value: i64]
  (arr.push! columns^.entities entity)
  (arr.push! columns^.values value))

(defn empty-entity-string-pair-columns [] -> Entity-String-Pair-Columns
  (Entity-String-Pair-Columns {entities: (make [dynamic]u64)
                               strings: (make [dynamic]string)}))

(defn delete-entity-string-pair-columns [columns: Entity-String-Pair-Columns]
  (when columns.owns-strings
    (for [text columns.strings]
      (delete text)))
  (delete columns.entities)
  (delete columns.strings))

(defn delete-entity-string-pair-columns-shallow [columns: Entity-String-Pair-Columns]
  (delete columns.entities)
  (delete columns.strings))

(defn append-entity-string-pair-column! [columns: ^Entity-String-Pair-Columns, entity: u64, text: string]
  (arr.push! columns^.entities entity)
  (arr.push! columns^.strings text))

(defn append-owned-entity-string-pair-column! [columns: ^Entity-String-Pair-Columns, entity: u64, text: string]
  (arr.push! columns^.entities entity)
  (arr.push! columns^.strings (string-owned text))
  (set! columns^.owns-strings true))

(defn empty-string-string-pair-columns [] -> String-String-Pair-Columns
  (String-String-Pair-Columns {first: (make [dynamic]string)
                               second: (make [dynamic]string)}))

(defn delete-string-string-pair-columns [columns: String-String-Pair-Columns]
  (when columns.owns-strings
    (for [text columns.first]
      (delete text))
    (for [text columns.second]
      (delete text)))
  (delete columns.first)
  (delete columns.second))

(defn delete-string-string-pair-columns-shallow [columns: String-String-Pair-Columns]
  (delete columns.first)
  (delete columns.second))

(defn append-owned-string-string-pair-column! [columns: ^String-String-Pair-Columns, first: string, second: string]
  (arr.push! columns^.first (string-owned first))
  (arr.push! columns^.second (string-owned second))
  (set! columns^.owns-strings true))

(defn empty-entity-string-int-triples [] -> Entity-String-Int-Triples
  (Entity-String-Int-Triples {entities: (make [dynamic]u64)
                              strings: (make [dynamic]string)
                              ints: (make [dynamic]i64)}))

(defn delete-entity-string-int-triples [columns: Entity-String-Int-Triples]
  (when columns.owns-strings
    (for [text columns.strings]
      (delete text)))
  (delete columns.entities)
  (delete columns.strings)
  (delete columns.ints))

(defn delete-entity-string-int-triples-shallow [columns: Entity-String-Int-Triples]
  (delete columns.entities)
  (delete columns.strings)
  (delete columns.ints))

(defn reset-entity-string-int-triples-capacity! [columns: ^Entity-String-Int-Triples, capacity: int]
  (when columns^.owns-strings
    (for [text columns^.strings]
      (delete text)))
  (delete columns^.entities)
  (delete columns^.strings)
  (delete columns^.ints)
  (set! columns^.entities (make [dynamic]u64 0 capacity))
  (set! columns^.strings (make [dynamic]string 0 capacity))
  (set! columns^.ints (make [dynamic]i64 0 capacity))
  (set! columns^.owns-strings false))

(defn append-entity-string-int-triple! [columns: ^Entity-String-Int-Triples, entity: u64, text: string, value: i64]
  (arr.push! columns^.entities entity)
  (arr.push! columns^.strings text)
  (arr.push! columns^.ints value))

(defn append-owned-entity-string-int-triple! [columns: ^Entity-String-Int-Triples, entity: u64, text: string, value: i64]
  (arr.push! columns^.entities entity)
  (arr.push! columns^.strings (string-owned text))
  (arr.push! columns^.ints value)
  (set! columns^.owns-strings true))

(defn empty-entity-two-value-plan [] -> Entity-Two-Value-Plan
  (Entity-Two-Value-Plan {filters: (make [dynamic]Entity-Int-Pair-Filter)}))

(defn empty-entity-int-threshold-plan [] -> Entity-Int-Threshold-Plan
