                  (= (count query.collection-inputs) 0)
                  (= (count query.tuple-inputs) 0)
                  (= (count query.relation-inputs) 0)
                  (= (count query.pulls) 0)
                  (= (count query.aggregates) 0)
                  (= (count query.rules) 0)
                  (= (count query.rule-calls) 0)
                  (= (count query.predicates) 0)
                  (= (count query.function-clauses) 0)
                  (= (count query.get-elses) 0)
                  (= (count query.get-somes) 0)
                  (= (count query.grounds) 0)
                  (= (count query.not-groups) 0)
                  (= (count query.or-groups) 0)
                  (= (count query.clauses) 1)
                  (= (count query.where-steps) 1)
                  (= query.where-steps[0].kind .Clause)))
    (return (empty-source-attr-value-entity-projection) false))
  (let [clause-value query.clauses[0]]
    (when (or (not (= clause-value.e.kind .Var))
              (not (= query.find[0] clause-value.e.name))
              (not (= clause-value.a.kind .Value))
              (not (= clause-value.a.value.kind .Keyword))
              (not (= clause-value.v.kind .Value))
              (not (= clause-value.tx-term.kind .Wildcard))
              (not (= clause-value.op-term.kind .Wildcard)))
      (return (empty-source-attr-value-entity-projection) false))
    (return (Source-Attr-Value-Entity-Projection {entity-var: clause-value.e.name
                                                  attr: clause-value.a.value.text
                                                  value: clause-value.v.value})
            true)))

(defn db-read-source-query-has-one-scalar-input? [query: Query, name: string] -> bool
  (when (not (= (count query.inputs) 1))
    (return false))
  (when (not (= query.inputs[0] name))
    (return false))
  (if (> (count query.input-specs) 0)
    (and (= (count query.input-specs) 1)
         (= query.input-specs[0].kind .Scalar)
         (= query.input-specs[0].name name))
    true))

(defn db-read-source-query-attr-input-entity-projection [query: Query] -> [projection: Source-Attr-Input-Entity-Projection, ok: bool]
  (when (not (and (= (count query.find) 1)
                  (= (count query.with) 0)
                  (= (count query.collection-inputs) 0)
                  (= (count query.tuple-inputs) 0)
                  (= (count query.relation-inputs) 0)
                  (= (count query.pulls) 0)
                  (= (count query.aggregates) 0)
                  (= (count query.rules) 0)
                  (= (count query.rule-calls) 0)
                  (= (count query.predicates) 0)
                  (= (count query.function-clauses) 0)
                  (= (count query.get-elses) 0)
                  (= (count query.get-somes) 0)
                  (= (count query.grounds) 0)
                  (= (count query.not-groups) 0)
                  (= (count query.or-groups) 0)
                  (= (count query.clauses) 1)
                  (= (count query.where-steps) 1)
                  (= query.where-steps[0].kind .Clause)))
    (return (empty-source-attr-input-entity-projection) false))
  (let [clause-value query.clauses[0]]
    (when (or (not (= clause-value.e.kind .Var))
              (not (= query.find[0] clause-value.e.name))
              (not (= clause-value.a.kind .Value))
              (not (= clause-value.a.value.kind .Keyword))
              (not (= clause-value.v.kind .Var))
              (not (db-read-source-query-has-one-scalar-input? query clause-value.v.name))
              (not (= clause-value.tx-term.kind .Wildcard))
              (not (= clause-value.op-term.kind .Wildcard)))
      (return (empty-source-attr-input-entity-projection) false))
    (return (Source-Attr-Input-Entity-Projection {entity-var: clause-value.e.name
                                                  attr: clause-value.a.value.text
                                                  input-var: clause-value.v.name})
            true)))

