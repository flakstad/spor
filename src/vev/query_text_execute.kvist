(package vev)

(defn q-prepared [db: DB, prepared: Prepared-Query] -> Result-Set
  (let [db-alias db]
    (q-prepared-db-read-source (resident-db-read-source (addr db-alias)) prepared)))

(defn q-result-prepared [db: DB, prepared: Prepared-Query] -> Query-Result
  (let [db-alias db]
    (query-result-owned-copy (q-result-prepared-db-read-source (resident-db-read-source (addr db-alias)) prepared))))

(defn q-prepared-db-read-source-with-sources-inputs-and-fns [source: DB-Read-Source, sources: []DB-Read-Named-Source, prepared: Prepared-Query, inputs: []Query-Input, registry: []Native-Query-Fn] -> Result-Set
  (if prepared.ok
    (db-read-source-q-query-with-sources-inputs-and-fns source sources prepared.query inputs registry)
    (result-set-error prepared.error)))

(defn q-prepared-db-read-source-profiled-with-sources-inputs-and-fns [source: DB-Read-Source, sources: []DB-Read-Named-Source, prepared: Prepared-Query, inputs: []Query-Input, registry: []Native-Query-Fn] -> Profiled-Result-Set
  (if prepared.ok
    (let [[typed-result typed-stats typed-used] (db-read-source-q-query-relation-value-typed-with-sources-inputs-and-fns source sources prepared.query inputs registry)]
      (when typed-used
        (set! typed-stats.clauses (query-logical-clause-count prepared.query))
        (when (and (> (count inputs) 0)
                   (= typed-stats.input-bindings 0))
          (let [[input-binding-count input-binding-ok] (db-read-source-query-input-binding-count source prepared.query inputs)]
            (when input-binding-ok
              (set! typed-stats.input-bindings input-binding-count))))
        (return (profiled-result-set typed-result typed-stats)))
      (delete-result-rows-owned-values typed-result.rows)
      (let [result (db-read-source-q-query-with-sources-inputs-and-fns source sources prepared.query inputs registry)
            stats (db-read-source-query-profile-stats-with-source-inputs-and-fns source sources prepared.query inputs result registry)]
        (profiled-result-set result stats)))
    (profiled-result-set (result-set-error prepared.error) (query-stats-empty))))

(defn q-prepared-db-read-source [source: DB-Read-Source, prepared: Prepared-Query] -> Result-Set
  (q-prepared-db-read-source-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared ([]Query-Input []) ([]Native-Query-Fn [])))

(defn q-prepared-db-read-source-profiled [source: DB-Read-Source, prepared: Prepared-Query] -> Profiled-Result-Set
  (q-prepared-db-read-source-profiled-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared ([]Query-Input []) ([]Native-Query-Fn [])))

(defn q-prepared-db-read-source-profiled-with-inputs [source: DB-Read-Source, prepared: Prepared-Query, inputs: []Query-Input] -> Profiled-Result-Set
  (q-prepared-db-read-source-profiled-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared inputs ([]Native-Query-Fn [])))

(defn q-prepared-db-read-source-profiled-with-rules-and-fns [source: DB-Read-Source, prepared: Prepared-Query, prepared-rules: Prepared-Rules, inputs: []Query-Input, registry: []Native-Query-Fn] -> Profiled-Result-Set
  (cond
    (not prepared.ok) (profiled-result-set (result-set-error prepared.error) (query-stats-empty))
    (not prepared-rules.ok) (profiled-result-set (result-set-error prepared-rules.error) (query-stats-empty))
    :else (let [query-value (query-with-rule-call-plans (query-copy-with-rules prepared.query (slice prepared-rules.rules 0)))
                prepared-value (Prepared-Query {ok: true error: "" query: query-value})
                profiled (q-prepared-db-read-source-profiled-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared-value inputs registry)]
            (delete-query-shallow query-value)
            profiled)))

(defn q-prepared-db-read-source-profiled-with-rules [source: DB-Read-Source, prepared: Prepared-Query, prepared-rules: Prepared-Rules, inputs: []Query-Input] -> Profiled-Result-Set
  (q-prepared-db-read-source-profiled-with-rules-and-fns source prepared prepared-rules inputs ([]Native-Query-Fn [])))

(defn q-prepared-db-read-source-with-fns [source: DB-Read-Source, prepared: Prepared-Query, registry: []Native-Query-Fn] -> Result-Set
  (q-prepared-db-read-source-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared ([]Query-Input []) registry))

(defn q-prepared-db-read-source-with-inputs [source: DB-Read-Source, prepared: Prepared-Query, inputs: []Query-Input] -> Result-Set
  (q-prepared-db-read-source-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared inputs ([]Native-Query-Fn [])))

(defn q-prepared-db-read-source-with-inputs-and-fns [source: DB-Read-Source, prepared: Prepared-Query, inputs: []Query-Input, registry: []Native-Query-Fn] -> Result-Set
  (q-prepared-db-read-source-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared inputs registry))

(defn q-prepared-db-read-source-with-sources [source: DB-Read-Source, sources: []DB-Read-Named-Source, prepared: Prepared-Query] -> Result-Set
  (q-prepared-db-read-source-with-sources-inputs-and-fns source sources prepared ([]Query-Input []) ([]Native-Query-Fn [])))

(defn q-prepared-db-read-source-with-sources-and-inputs [source: DB-Read-Source, sources: []DB-Read-Named-Source, prepared: Prepared-Query, inputs: []Query-Input] -> Result-Set
  (q-prepared-db-read-source-with-sources-inputs-and-fns source sources prepared inputs ([]Native-Query-Fn [])))

(defn q-prepared-db-read-source-with-sources-and-fns [source: DB-Read-Source, sources: []DB-Read-Named-Source, prepared: Prepared-Query, registry: []Native-Query-Fn] -> Result-Set
  (q-prepared-db-read-source-with-sources-inputs-and-fns source sources prepared ([]Query-Input []) registry))

(defn query-source-plain-clause-var? [query-value: Query, name: string] -> bool
  (let [index 0]
    (while (< index (count query-value.clauses))
      (let [clause-value query-value.clauses[index]]
        (when (not clause-value.has-source)
          (when (and (= clause-value.e.kind .Var) (= clause-value.e.name name))
            (return true))
          (when (and (= clause-value.a.kind .Var) (= clause-value.a.name name))
            (return true))
          (when (and (= clause-value.v.kind .Var) (= clause-value.v.name name))
            (return true))
          (when (and (= clause-value.tx-term.kind .Var) (= clause-value.tx-term.name name))
            (return true))
          (when (and (= clause-value.op-term.kind .Var) (= clause-value.op-term.name name))
            (return true))))
      (set! index (+ index 1))))
  false)

(defn query-source-result-shallow-safe? [query-value: Query] -> bool
  (when (or (> (count query-value.pulls) 0)
            (> (count query-value.aggregates) 0)
            (> (count query-value.function-clauses) 0)
            (> (count query-value.grounds) 0)
            (> (count query-value.get-elses) 0)
            (> (count query-value.get-somes) 0)
            (> (count query-value.rule-calls) 0)
            (> (count query-value.rules) 0))
    (return false))
  (for [name query-value.find]
    (when (not (query-source-plain-clause-var? query-value name))
      (return false)))
  (for [name query-value.with]
    (when (not (query-source-plain-clause-var? query-value name))
      (return false)))
  true)

(defn query-result-db-read-source-query-result [query-value: Query, result: Result-Set] -> Query-Result
  (cond
    (not result.ok) (query-result-owned-values result)
    (query-source-result-shallow-safe? query-value) (query-result-shallow result)
    :else (query-result-owned-values result)))

(defn query-result-db-read-source-query-result-owned [query-value: Query, result: Result-Set] -> Query-Result
  (cond
    (not result.ok) (query-result-owned-values result)
    (query-source-result-shallow-safe? query-value)
      (let [owned (query-result-owned-values (result-set-owned result))]
        (delete-result-set-shallow result)
        owned)
    :else (query-result-owned-values result)))

(defn query-result-db-read-source-result [result: Result-Set] -> Query-Result
  (if result.ok
    (query-result-shallow result)
    (query-result-owned-values result)))

(defn q-result-prepared-db-read-source-with-sources-inputs-and-fns [source: DB-Read-Source, sources: []DB-Read-Named-Source, prepared: Prepared-Query, inputs: []Query-Input, registry: []Native-Query-Fn] -> Query-Result
  (if prepared.ok
    (query-result-db-read-source-query-result prepared.query (db-read-source-q-query-with-sources-inputs-and-fns source sources prepared.query inputs registry))
    (query-result-owned-values (result-set-error prepared.error))))

(defn q-result-prepared-db-read-source-owned-with-sources-inputs-and-fns [source: DB-Read-Source, sources: []DB-Read-Named-Source, prepared: Prepared-Query, inputs: []Query-Input, registry: []Native-Query-Fn] -> Query-Result
  (if prepared.ok
    (query-result-db-read-source-query-result-owned prepared.query (db-read-source-q-query-with-sources-inputs-and-fns source sources prepared.query inputs registry))
    (query-result-owned-values (result-set-error prepared.error))))

(defn q-result-prepared-db-read-source [source: DB-Read-Source, prepared: Prepared-Query] -> Query-Result
  (q-result-prepared-db-read-source-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared ([]Query-Input []) ([]Native-Query-Fn [])))

(defn q-result-prepared-db-read-source-owned [source: DB-Read-Source, prepared: Prepared-Query] -> Query-Result
  (q-result-prepared-db-read-source-owned-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared ([]Query-Input []) ([]Native-Query-Fn [])))

(defn q-result-prepared-db-read-source-with-inputs [source: DB-Read-Source, prepared: Prepared-Query, inputs: []Query-Input] -> Query-Result
  (q-result-prepared-db-read-source-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared inputs ([]Native-Query-Fn [])))

(defn q-result-prepared-db-read-source-owned-with-inputs [source: DB-Read-Source, prepared: Prepared-Query, inputs: []Query-Input] -> Query-Result
  (q-result-prepared-db-read-source-owned-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared inputs ([]Native-Query-Fn [])))

(defn q-result-prepared-db-read-source-with-sources [source: DB-Read-Source, sources: []DB-Read-Named-Source, prepared: Prepared-Query] -> Query-Result
  (q-result-prepared-db-read-source-with-sources-inputs-and-fns source sources prepared ([]Query-Input []) ([]Native-Query-Fn [])))

(defn q-prepared-db-read-source-with-rules-and-fns [source: DB-Read-Source, prepared: Prepared-Query, prepared-rules: Prepared-Rules, inputs: []Query-Input, registry: []Native-Query-Fn] -> Result-Set
  (cond
    (not prepared.ok) (result-set-error prepared.error)
    (not prepared-rules.ok) (result-set-error prepared-rules.error)
    :else (let [query-value (query-with-rule-call-plans (query-copy-with-rules prepared.query (slice prepared-rules.rules 0)))
                result (db-read-source-q-query-with-inputs-and-fns source query-value inputs registry)]
            (delete-query-shallow query-value)
            result)))

(defn q-prepared-db-read-source-with-rules [source: DB-Read-Source, prepared: Prepared-Query, prepared-rules: Prepared-Rules, inputs: []Query-Input] -> Result-Set
  (q-prepared-db-read-source-with-rules-and-fns source prepared prepared-rules inputs ([]Native-Query-Fn [])))

(defn q-result-prepared-db-read-source-with-rules-and-fns [source: DB-Read-Source, prepared: Prepared-Query, prepared-rules: Prepared-Rules, inputs: []Query-Input, registry: []Native-Query-Fn] -> Query-Result
  (cond
    (not prepared.ok) (query-result-owned-values (result-set-error prepared.error))
    (not prepared-rules.ok) (query-result-owned-values (result-set-error prepared-rules.error))
    :else (let [query-value (query-with-rule-call-plans (query-copy-with-rules prepared.query (slice prepared-rules.rules 0)))
                result (db-read-source-q-query-with-inputs-and-fns source query-value inputs registry)
                out (query-result-db-read-source-query-result query-value result)]
            (delete-query-shallow query-value)
            out)))

(defn q-result-prepared-db-read-source-with-rules [source: DB-Read-Source, prepared: Prepared-Query, prepared-rules: Prepared-Rules, inputs: []Query-Input] -> Query-Result
  (q-result-prepared-db-read-source-with-rules-and-fns source prepared prepared-rules inputs ([]Native-Query-Fn [])))

(defn q-text-db-read-source [source: DB-Read-Source, text: string] -> Result-Set
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (q-prepared-db-read-source source prepared)))

(defn q-text-db-read-source-with-fns [source: DB-Read-Source, text: string, registry: []Native-Query-Fn] -> Result-Set
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (q-prepared-db-read-source-with-fns source prepared registry)))

(defn q-text-db-read-source-with-inputs [source: DB-Read-Source, text: string, inputs: []Query-Input] -> Result-Set
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (q-prepared-db-read-source-with-inputs source prepared inputs)))

(defn q-text-db-read-source-with-inputs-and-fns [source: DB-Read-Source, text: string, inputs: []Query-Input, registry: []Native-Query-Fn] -> Result-Set
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (q-prepared-db-read-source-with-inputs-and-fns source prepared inputs registry)))

(defn q-text-db-read-source-with-sources-inputs-and-fns [source: DB-Read-Source, sources: []DB-Read-Named-Source, text: string, inputs: []Query-Input, registry: []Native-Query-Fn] -> Result-Set
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (q-prepared-db-read-source-with-sources-inputs-and-fns source sources prepared inputs registry)))

(defn q-text-db-read-source-profiled-with-sources-inputs-and-fns [source: DB-Read-Source, sources: []DB-Read-Named-Source, text: string, inputs: []Query-Input, registry: []Native-Query-Fn] -> Profiled-Result-Set
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (q-prepared-db-read-source-profiled-with-sources-inputs-and-fns source sources prepared inputs registry)))

(defn q-text-db-read-source-profiled [source: DB-Read-Source, text: string] -> Profiled-Result-Set
  (q-text-db-read-source-profiled-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) text ([]Query-Input []) ([]Native-Query-Fn [])))

(defn q-text-db-read-source-profiled-with-inputs [source: DB-Read-Source, text: string, inputs: []Query-Input] -> Profiled-Result-Set
  (q-text-db-read-source-profiled-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) text inputs ([]Native-Query-Fn [])))

(defn q-text-db-read-source-with-sources [source: DB-Read-Source, sources: []DB-Read-Named-Source, text: string] -> Result-Set
  (q-text-db-read-source-with-sources-inputs-and-fns source sources text ([]Query-Input []) ([]Native-Query-Fn [])))

(defn q-text-db-read-source-with-sources-and-inputs [source: DB-Read-Source, sources: []DB-Read-Named-Source, text: string, inputs: []Query-Input] -> Result-Set
  (q-text-db-read-source-with-sources-inputs-and-fns source sources text inputs ([]Native-Query-Fn [])))

(defn q-text-db-read-source-with-sources-and-fns [source: DB-Read-Source, sources: []DB-Read-Named-Source, text: string, registry: []Native-Query-Fn] -> Result-Set
  (q-text-db-read-source-with-sources-inputs-and-fns source sources text ([]Query-Input []) registry))

(defn q-text-db-read-source-with-input-text [source: DB-Read-Source, text: string, inputs-text: string] -> Result-Set
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (when (not prepared.ok)
      (return (result-set-error prepared.error)))
    (let [[inputs input-ok input-error] (parse-query-inputs-text-for-query prepared.query inputs-text)]
      (when (not input-ok)
        (return (result-set-error input-error)))
      (let [result (q-prepared-db-read-source-with-inputs source prepared (slice inputs 0))]
        (delete-owned-query-inputs inputs)
        result))))

(defn q-text-db-read-source-profiled-with-input-text [source: DB-Read-Source, text: string, inputs-text: string] -> Profiled-Result-Set
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (when (not prepared.ok)
      (return (profiled-result-set (result-set-error prepared.error) (query-stats-empty))))
    (let [[inputs input-ok input-error] (parse-query-inputs-text-for-query prepared.query inputs-text)]
      (when (not input-ok)
        (return (profiled-result-set (result-set-error input-error) (query-stats-empty))))
      (let [profiled (q-prepared-db-read-source-profiled-with-inputs source prepared (slice inputs 0))]
        (delete-owned-query-inputs inputs)
        profiled))))

(defn q-text-db-read-source-with-input-text-and-fns [source: DB-Read-Source, text: string, inputs-text: string, registry: []Native-Query-Fn] -> Result-Set
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (when (not prepared.ok)
      (return (result-set-error prepared.error)))
    (let [[inputs input-ok input-error] (parse-query-inputs-text-for-query prepared.query inputs-text)]
      (when (not input-ok)
        (return (result-set-error input-error)))
      (let [result (q-prepared-db-read-source-with-inputs-and-fns source prepared (slice inputs 0) registry)]
        (delete-owned-query-inputs inputs)
        result))))

(defn q-result-text-db-read-source [source: DB-Read-Source, text: string] -> Query-Result
  (q-result-text-db-read-source-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) text ([]Query-Input []) ([]Native-Query-Fn [])))

