(defn q-prepared-with-rules [db: DB, prepared: Prepared-Query, prepared-rules: Prepared-Rules, inputs: []Query-Input] -> Result-Set
  (let [db-alias db]
    (q-prepared-db-read-source-with-rules-and-fns
      (resident-db-read-source (addr db-alias))
      prepared
      prepared-rules
      inputs
      ([]Native-Query-Fn []))))

