(defn q-prepared-with-sources [db: DB, prepared: Prepared-Query, inputs: []Query-Input, sources: []DB-Source] -> Result-Set
  (if prepared.ok
    (let [db-alias db
          source-db-aliases (make [dynamic]DB 0 (count sources)) :defer
          read-sources (make [dynamic]DB-Read-Named-Source 0 (count sources)) :defer
          _ (append-db-read-named-sources-from-db-sources! (addr read-sources) (addr source-db-aliases) sources)]
      (db-read-source-q-query-with-sources-inputs-and-fns
        (resident-db-read-source (addr db-alias))
        (slice read-sources 0)
        prepared.query
        inputs
        ([]Native-Query-Fn [])))
    (result-set-error prepared.error)))

