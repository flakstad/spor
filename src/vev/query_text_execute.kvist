(defn q-result-text-db-read-source-with-sources-inputs-and-fns [source: DB-Read-Source, sources: []DB-Read-Named-Source, text: string, inputs: []Query-Input, registry: []Native-Query-Fn] -> Query-Result
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (q-result-prepared-db-read-source-with-sources-inputs-and-fns source sources prepared inputs registry)))

(defn q-result-text-db-read-source-owned-with-sources-inputs-and-fns [source: DB-Read-Source, sources: []DB-Read-Named-Source, text: string, inputs: []Query-Input, registry: []Native-Query-Fn] -> Query-Result
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (q-result-prepared-db-read-source-owned-with-sources-inputs-and-fns source sources prepared inputs registry)))

(defn q-result-text-db-read-source-owned [source: DB-Read-Source, text: string] -> Query-Result
  (q-result-text-db-read-source-owned-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) text ([]Query-Input []) ([]Native-Query-Fn [])))

(defn q-result-text-db-read-source-with-sources [source: DB-Read-Source, sources: []DB-Read-Named-Source, text: string] -> Query-Result
  (q-result-text-db-read-source-with-sources-inputs-and-fns source sources text ([]Query-Input []) ([]Native-Query-Fn [])))

(defn q-result-text-db-read-source-with-sources-and-inputs [source: DB-Read-Source, sources: []DB-Read-Named-Source, text: string, inputs: []Query-Input] -> Query-Result
  (q-result-text-db-read-source-with-sources-inputs-and-fns source sources text inputs ([]Native-Query-Fn [])))

(defn q-result-text-db-read-source-with-sources-and-fns [source: DB-Read-Source, sources: []DB-Read-Named-Source, text: string, registry: []Native-Query-Fn] -> Query-Result
  (q-result-text-db-read-source-with-sources-inputs-and-fns source sources text ([]Query-Input []) registry))

(defn q-result-text-db-read-source-with-input-text [source: DB-Read-Source, text: string, inputs-text: string] -> Query-Result
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (when (not prepared.ok)
      (return (query-result-owned-values (result-set-error prepared.error))))
    (let [[inputs input-ok input-error] (parse-query-inputs-text-for-query prepared.query inputs-text)]
      (when (not input-ok)
        (return (query-result-owned-values (result-set-error input-error))))
      (let [out (q-result-prepared-db-read-source-with-inputs source prepared (slice inputs 0))]
        (delete-owned-query-inputs inputs)
        out))))

(defn q-result-text-db-read-source-owned-with-input-text [source: DB-Read-Source, text: string, inputs-text: string] -> Query-Result
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (when (not prepared.ok)
      (return (query-result-owned-values (result-set-error prepared.error))))
    (let [[inputs input-ok input-error] (parse-query-inputs-text-for-query prepared.query inputs-text)]
      (when (not input-ok)
        (return (query-result-owned-values (result-set-error input-error))))
      (let [out (q-result-prepared-db-read-source-owned-with-inputs source prepared (slice inputs 0))]
        (delete-owned-query-inputs inputs)
        out))))

(defn q-result-text-db-read-source-with-input-text-and-fns [source: DB-Read-Source, text: string, inputs-text: string, registry: []Native-Query-Fn] -> Query-Result
  (let [prepared (prepare-query-text text)]
    (defer (delete-prepared-query-shallow prepared))
    (when (not prepared.ok)
      (return (query-result-owned-values (result-set-error prepared.error))))
    (let [[inputs input-ok input-error] (parse-query-inputs-text-for-query prepared.query inputs-text)]
      (when (not input-ok)
        (return (query-result-owned-values (result-set-error input-error))))
      (let [out (q-result-prepared-db-read-source-with-sources-inputs-and-fns source ([]DB-Read-Named-Source []) prepared (slice inputs 0) registry)]
        (delete-owned-query-inputs inputs)
        out))))

(defn q-prepared-value [db: DB, prepared: Prepared-Query] -> Value
  (result-set-value db (q-prepared db prepared)))

(defn q-prepared-with-fns [db: DB, prepared: Prepared-Query, registry: []Native-Query-Fn] -> Result-Set
  (let [db-alias db]
    (q-prepared-db-read-source-with-fns (resident-db-read-source (addr db-alias)) prepared registry)))

(defn q-prepared-value-with-fns [db: DB, prepared: Prepared-Query, registry: []Native-Query-Fn] -> Value
  (result-set-value db (q-prepared-with-fns db prepared registry)))

(defn q-prepared-with-inputs [db: DB, prepared: Prepared-Query, inputs: []Query-Input] -> Result-Set
  (let [db-alias db]
    (q-prepared-db-read-source-with-inputs (resident-db-read-source (addr db-alias)) prepared inputs)))

(defn q-prepared-value-with-inputs [db: DB, prepared: Prepared-Query, inputs: []Query-Input] -> Value
  (result-set-value db (q-prepared-with-inputs db prepared inputs)))

(defn q-prepared-with-inputs-and-fns [db: DB, prepared: Prepared-Query, inputs: []Query-Input, registry: []Native-Query-Fn] -> Result-Set
  (let [db-alias db]
    (q-prepared-db-read-source-with-inputs-and-fns (resident-db-read-source (addr db-alias)) prepared inputs registry)))

(defn q-result-prepared-with-fns [db: DB, prepared: Prepared-Query, registry: []Native-Query-Fn] -> Query-Result
  (let [db-alias db]
    (query-result-owned-copy
      (q-result-prepared-db-read-source-with-sources-inputs-and-fns (resident-db-read-source (addr db-alias)) ([]DB-Read-Named-Source []) prepared ([]Query-Input []) registry))))

(defn q-result-prepared-with-inputs [db: DB, prepared: Prepared-Query, inputs: []Query-Input] -> Query-Result
  (let [db-alias db]
    (query-result-owned-copy (q-result-prepared-db-read-source-with-inputs (resident-db-read-source (addr db-alias)) prepared inputs))))

