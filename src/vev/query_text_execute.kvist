(defn q-prepared-relation-db-with-rules [rows: Value, prepared: Prepared-Query, prepared-rules: Prepared-Rules, inputs: []Query-Input] -> Result-Set
  (cond
    (not prepared.ok) (result-set-error prepared.error)
    (not prepared-rules.ok) (result-set-error prepared-rules.error)
    :else (let [query-value (query-with-rule-call-plans (query-copy-with-rules prepared.query (slice prepared-rules.rules 0)))
                result (q-query-relation-db rows query-value inputs)]
            (delete-query-shallow query-value)
            result)))

(defn q-prepared-relation-db-with-rules-and-fns [rows: Value, prepared: Prepared-Query, prepared-rules: Prepared-Rules, inputs: []Query-Input, registry: []Native-Query-Fn] -> Result-Set
