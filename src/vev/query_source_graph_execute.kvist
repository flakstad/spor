        (mut! stats^.clause-candidates += hop1-candidates))
      (arr.sort! hop1-entity-list)
      (let [[hop2-ok hop2-error hop2-scans hop2-candidates] (append-source-multi-hop-ref-chain-propagated-links-from-frontier! source projection.hop2-attr (slice hop1-entity-list 0) (addr hop1-heads) (slice hop1-links 0) (addr hop2-entities) (addr hop2-entity-list) (addr hop2-heads) (addr hop2-links))]
