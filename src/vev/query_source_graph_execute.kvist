      (let [[final-ok final-error final-scans final-candidates] (append-source-multi-hop-ref-chain-final-value-rows-from-frontier! source projection.final-value-attr (slice hop2-entity-list 0) (addr hop2-heads) (slice hop2-links 0) (addr builder) (addr seen) query projection)]
