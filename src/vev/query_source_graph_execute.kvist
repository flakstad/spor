        (mut! stats^.clause-candidates += final-candidates))
      (mut! stats^.clauses += 7)
      (return (source-query-relation-from-multi-hop-builder attrs builder) true ""))))

(defn db-read-source-query-relation-multi-hop-ref-chain-final-filter-batched [source: DB-Read-Source, query: Query, projection: Source-Multi-Hop-Ref-Chain-Projection, inputs: []Query-Input, stats: ^Query-Stats] -> [rel: Query-Relation, ok: bool, error: string]
  (when (db-read-source-has-overlay? source)
