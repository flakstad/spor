                        (delete attrs)
                        (delete-query-relation-builder builder)
                        (return (query-relation-empty) false "source multi-hop ref-chain final-filter relation could not add typed row"))
                      (set! index final-links[index].next)))))
              (let [[advance-ok advance-error] (advance-source-index-datom-stream! source (addr final-frontier-stream))]
                (when (not advance-ok)
                  (delete-source-index-datom-stream final-frontier-stream)
