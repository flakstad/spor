      (let [[first-value-ok first-value-error first-value-scans first-value-candidates] (append-source-multi-hop-ref-chain-first-value-links-from-parent-frontier! source projection.first-value-attr (slice first-entity-list 0) (addr filter-heads) (slice filter-links 0) (addr first-value-heads) (addr first-value-links))]
