          (delete attrs)
          (delete-query-relation-builder builder)
          (return (query-relation-empty) false final-frontier-error))
        (if final-frontier-used
          (do
            (when (> (count final-entity-list) 0)
              (mut! stats^.source-index-scans += 1))
            (when (>= final-frontier-candidates 0)
              (mut! stats^.clause-candidates += final-frontier-candidates))
            (while final-frontier-stream.has-current
              (when (< final-frontier-candidates 0)
                (mut! stats^.clause-candidates += 1))
              (let [[head found] (mmap.get final-heads final-frontier-stream.current.e)]
                (when found
                  (let [index head]
