(defn q-db-read-source-multi-hop-ref-chain-projection-batched [source: DB-Read-Source, query: Query, projection: Source-Multi-Hop-Ref-Chain-Projection, inputs: []Query-Input] -> Result-Set
  (let [rows (make [dynamic]Result-Row)
        [anchor-value anchor-value-ok anchor-value-error] (db-read-source-multi-hop-ref-chain-anchor-value source projection inputs)]
    (when (not anchor-value-ok)
      (return (result-set-error anchor-value-error)))
      (let [anchor-entities (set.empty u64) :defer
          anchor-entity-list (make [dynamic]u64) :defer
          first-entities (set.empty u64) :defer
          first-entity-list (make [dynamic]u64) :defer
          filter-heads (make (map u64 int)) :defer
          filter-links (make [dynamic]Source-Multi-Hop-Ref-Chain-Link)
          first-value-heads (make (map u64 int)) :defer
          first-value-links (make [dynamic]Source-Multi-Hop-Ref-Chain-Link)
          hop1-heads (make (map u64 int)) :defer
          hop1-links (make [dynamic]Source-Multi-Hop-Ref-Chain-Link)
          hop2-heads (make (map u64 int)) :defer
          hop2-links (make [dynamic]Source-Multi-Hop-Ref-Chain-Link)]
      (defer (delete-source-multi-hop-ref-chain-links filter-links))
      (defer (delete-source-multi-hop-ref-chain-links first-value-links))
      (defer (delete-source-multi-hop-ref-chain-links hop1-links))
      (defer (delete-source-multi-hop-ref-chain-links hop2-links))
      (let [[anchor-stream anchor-ok anchor-error] (source-attr-value-match-stream source projection.anchor-attr anchor-value)]
        (when (not anchor-ok)
          (return (result-set-error anchor-error)))
        (while anchor-stream.has-current
          (let [anchor-datom (source-attr-value-match-current anchor-stream)]
            (when (not (set.contains? anchor-entities anchor-datom.e))
              (set.add! anchor-entities anchor-datom.e)
              (arr.push! anchor-entity-list anchor-datom.e)))
          (let [[anchor-advance-ok anchor-advance-error] (advance-source-attr-value-match-stream! source (addr anchor-stream))]
            (when (not anchor-advance-ok)
              (delete-source-attr-value-match-stream anchor-stream)
              (return (result-set-error anchor-advance-error)))))
        (delete-source-attr-value-match-stream anchor-stream))
      (arr.sort! anchor-entity-list)
      (let [[reverse-ok reverse-error _ _] (append-source-multi-hop-ref-chain-first-entities-from-frontier! source projection.reverse-ref-attr (slice anchor-entity-list 0) (addr first-entities) (addr first-entity-list))]
        (when (not reverse-ok)
          (return (result-set-error reverse-error))))
      (let [[filter-ok filter-error] (append-source-multi-hop-ref-chain-filter-links! source projection (addr first-entities) (addr filter-heads) (addr filter-links))]
        (when (not filter-ok)
          (delete-result-rows-owned-values rows)
          (return (result-set-error filter-error))))
      (let [[first-value-ok first-value-error] (append-source-multi-hop-ref-chain-first-value-links! source projection (addr filter-heads) (slice filter-links 0) (addr first-value-heads) (addr first-value-links))]
        (when (not first-value-ok)
          (delete-result-rows-owned-values rows)
          (return (result-set-error first-value-error))))
      (let [[hop1-ok hop1-error] (append-source-multi-hop-ref-chain-propagated-links! source projection.hop1-attr (addr first-value-heads) (slice first-value-links 0) (addr hop1-heads) (addr hop1-links))]
        (when (not hop1-ok)
          (delete-result-rows-owned-values rows)
          (return (result-set-error hop1-error))))
      (let [[hop2-ok hop2-error] (append-source-multi-hop-ref-chain-propagated-links! source projection.hop2-attr (addr hop1-heads) (slice hop1-links 0) (addr hop2-heads) (addr hop2-links))]
        (when (not hop2-ok)
          (delete-result-rows-owned-values rows)
          (return (result-set-error hop2-error))))
      (let [[final-stream final-ok final-error] (source-index-datom-stream source projection.final-value-attr)]
        (when (not final-ok)
          (delete-result-rows-owned-values rows)
          (return (result-set-error final-error)))
        (while final-stream.has-current
          (let [[head found] (mmap.get hop2-heads final-stream.current.e)]
            (when found
              (let [index head]
                (while (>= index 0)
                  (append-db-read-source-multi-hop-ref-chain-row! (addr rows) query projection final-stream.current.v hop2-links[index].first-value hop2-links[index].filter-value)
                  (set! index hop2-links[index].next)))))
          (let [[advance-ok advance-error] (advance-source-index-datom-stream! source (addr final-stream))]
            (when (not advance-ok)
              (delete-source-index-datom-stream final-stream)
              (delete-result-rows-owned-values rows)
              (return (result-set-error advance-error)))))
        (delete-source-index-datom-stream final-stream))
      (result-set-ok rows))))

(defn db-read-source-query-relation-multi-hop-ref-chain-projection-batched [source: DB-Read-Source, query: Query, projection: Source-Multi-Hop-Ref-Chain-Projection, inputs: []Query-Input, stats: ^Query-Stats] -> [rel: Query-Relation, ok: bool, error: string]
  (when (db-read-source-has-overlay? source)
    (return (query-relation-empty) false ""))
  (let [attrs (arr.into [dynamic]string (slice query.find 0))
        builder (query-relation-builder (slice attrs 0))
        seen (set.empty string)
        [anchor-value anchor-value-ok anchor-value-error] (db-read-source-multi-hop-ref-chain-anchor-value source projection inputs)]
    (defer (delete-owned-string-set seen))
    (when (not anchor-value-ok)
      (delete attrs)
      (delete-query-relation-builder builder)
      (return (query-relation-empty) false anchor-value-error))
    (let [anchor-entities (set.empty u64) :defer
          anchor-entity-list (make [dynamic]u64) :defer
          first-entities (set.empty u64) :defer
          first-entity-list (make [dynamic]u64) :defer
          hop1-entities (set.empty u64) :defer
          hop1-entity-list (make [dynamic]u64) :defer
          hop2-entities (set.empty u64) :defer
          hop2-entity-list (make [dynamic]u64) :defer
          filter-heads (make (map u64 int)) :defer
          filter-links (make [dynamic]Source-Multi-Hop-Ref-Chain-Link)
          first-value-heads (make (map u64 int)) :defer
          first-value-links (make [dynamic]Source-Multi-Hop-Ref-Chain-Link)
          hop1-heads (make (map u64 int)) :defer
          hop1-links (make [dynamic]Source-Multi-Hop-Ref-Chain-Link)
          hop2-heads (make (map u64 int)) :defer
          hop2-links (make [dynamic]Source-Multi-Hop-Ref-Chain-Link)]
