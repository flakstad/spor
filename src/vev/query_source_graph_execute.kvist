                  (delete attrs)
                  (delete-query-relation-builder builder)
                  (return (query-relation-empty) false final-error))
                (while final-stream.has-current
                  (mut! stats^.clause-candidates += 1)
                  (let [[head found] (mmap.get final-heads final-stream.current.e)]
                    (when found
                      (let [index head]
                        (while (>= index 0)
                          (when (not (append-db-read-source-multi-hop-ref-chain-relation-row! (addr builder) (addr seen) query projection final-stream.current.v final-links[index].first-value final-links[index].filter-value))
                            (delete-source-index-datom-stream final-stream)
                            (delete attrs)
                            (delete-query-relation-builder builder)
                            (return (query-relation-empty) false "source multi-hop ref-chain final-filter relation could not add typed row"))
                          (set! index final-links[index].next)))))
                  (let [[advance-ok advance-error] (advance-source-index-datom-stream! source (addr final-stream))]
                    (when (not advance-ok)
                      (delete-source-index-datom-stream final-stream)
                      (delete attrs)
                      (delete-query-relation-builder builder)
                      (return (query-relation-empty) false advance-error))))
                (delete-source-index-datom-stream final-stream))))))
      (mut! stats^.clauses += 7)
      (return (source-query-relation-from-multi-hop-builder attrs builder) true ""))))

