(package vev-tests)

(import fmt "core:fmt")
(import os "core:os")
(import strings "core:strings")
(import t "kvist:test")
(import vev "../vev")

(defn remove-sqlite-files [path: string]
  (os.remove path)
  (let [wal-path (fmt.aprintf "%s-wal" path) :defer
        shm-path (fmt.aprintf "%s-shm" path) :defer]
    (os.remove wal-path)
    (os.remove shm-path))
  (return))

(t.deftest sqlite-new-store-records-separated-entity-partitions
  (defer (free_all context.allocator))
  (let [path "tmp.vev.storage-entity-partitions-new.sqlite"]
    (remove-sqlite-files path)
    (defer (remove-sqlite-files path))
    (let [[store opened-ok opened-error] (vev.open-store path)
          [layout layout-ok layout-error] (vev.sqlite-entity-partition-layout path)]
      (t.is opened-ok opened-error)
      (t.is layout-ok layout-error)
      (t.is (= layout "separated-v1"))
      (delete layout)
      (vev.close-store store))))

(t.deftest sqlite-nonempty-unmarked-store-requires-explicit-confirmation
  (defer (free_all context.allocator))
  (let [path "tmp.vev.storage-entity-partitions-legacy.sqlite"]
    (remove-sqlite-files path)
    (defer (remove-sqlite-files path))
    (let [[store opened-ok opened-error] (vev.open-store path)
          report (vev.transact-store-report-text (addr store) "[{:db/id 120 :item/state :state/old}]")]
      (t.is opened-ok opened-error)
      (t.is report.ok report.error)
      (vev.delete-store-tx-report report)
      (vev.close-store store))
    (let [[clear-ok clear-error] (vev.sqlite-clear-entity-partition-layout-for-test! path)]
      (t.is clear-ok clear-error))
    (let [[legacy legacy-ok legacy-error] (vev.open-store path)]
      (t.is (not legacy-ok))
      (t.is (strings.contains legacy-error "explicitly confirm or migrate"))
      (vev.close-store legacy))
    (let [[confirm-ok confirm-error] (vev.confirm-sqlite-entity-partition-layout! path)]
      (t.is confirm-ok confirm-error))
    (let [[reopened reopened-ok reopened-error] (vev.open-store path)
          [snapshot snapshot-ok snapshot-error] (vev.store-db (addr reopened))
          [source source-ok source-error] (vev.store-db-read-source (addr snapshot))
          [next-entity next-ok next-error] (vev.db-read-source-next-entity-id source)]
      (t.is reopened-ok reopened-error)
      (t.is snapshot-ok snapshot-error)
      (t.is source-ok source-error)
      (t.is next-ok next-error)
      (t.is (= next-entity 121))
      (vev.close-store-db snapshot)
      (vev.close-store reopened))))

(t.deftest sqlite-reopen-derives-next-entity-from-eavt-entry
  (defer (free_all context.allocator))
  (let [path "tmp.vev.storage-next-entity.sqlite"]
    (remove-sqlite-files path)
    (defer (remove-sqlite-files path))
    (let [[store opened-ok opened-error] (vev.open-store path)
          high (vev.transact-store-report-text (addr store) "[{:db/id 120 :item/state :state/old}]")
          lower (vev.transact-store-report-text (addr store) "[{:db/id 113 :item/marker true}]")]
      (t.is opened-ok opened-error)
      (t.is high.ok high.error)
      (t.is lower.ok lower.error)
      (vev.delete-store-tx-report high)
      (vev.delete-store-tx-report lower)
      (vev.close-store store))
    (let [[reopened reopened-ok reopened-error] (vev.open-store path)
          [snapshot snapshot-ok snapshot-error] (vev.store-db (addr reopened))
          [source source-ok source-error] (vev.store-db-read-source (addr snapshot))
          [next-entity next-ok next-error] (vev.db-read-source-next-entity-id source)
          replacement (vev.transact-store-report-text (addr reopened) "[[:db/add 120 :item/state :state/new]]")
          result (vev.q-result-store-text (addr reopened) "[:find ?state :where [120 :item/state ?state]]")]
      (t.is reopened-ok reopened-error)
      (t.is snapshot-ok snapshot-error)
      (t.is source-ok source-error)
      (t.is next-ok next-error)
      (t.is (= next-entity 121))
      (t.is replacement.ok replacement.error)
      (t.is result.result.ok result.result.error)
      (t.is (= (count result.result.rows) 1))
      (t.is (= result.result.rows[0].values[0].kind .Keyword))
      (t.is (= result.result.rows[0].values[0].text ":state/new"))
      (vev.delete-query-result result)
      (vev.delete-store-tx-report replacement)
      (vev.close-store-db snapshot)
      (vev.close-store reopened))))

(t.deftest sqlite-index-run-manifest-stores-entity-attr-prefix-ranges
  (defer (free_all context.allocator))
  (remove-sqlite-files "tmp.vev.storage-manifest-prefix.sqlite")
  (let [path "tmp.vev.storage-manifest-prefix.sqlite"
        [store opened-ok opened-error] (vev.open-store path)
        seed (vev.transact-store-report-tx-data
               (addr store)
               ([]vev.Tx-Data [(vev.add 1 ":item/name" (vev.value-string "one"))
                                (vev.add 1 ":item/rank" (vev.value-int 10))
                                (vev.add 2 ":item/name" (vev.value-string "two"))
                                (vev.add 2 ":item/friend" (vev.value-entity 1))
                                (vev.add 3 ":item/friend" (vev.value-entity 1))]))
        [eavt-manifest eavt-manifest-ok eavt-manifest-error] (vev.sqlite-create-index-run-manifest-for-test path ":eavt")
        [vaet-manifest vaet-manifest-ok vaet-manifest-error] (vev.sqlite-create-index-run-manifest-for-test path ":vaet")
        [eavt-first eavt-last eavt-found eavt-ok eavt-error] (vev.sqlite-index-run-manifest-entity-attr-range-for-test (addr store) eavt-manifest 0 ":eavt" 1 ":item/name")
        [eavt-missing-first eavt-missing-last eavt-missing-found eavt-missing-ok eavt-missing-error] (vev.sqlite-index-run-manifest-entity-attr-range-for-test (addr store) eavt-manifest 0 ":eavt" 42 ":item/name")
        [vaet-first vaet-last vaet-found vaet-ok vaet-error] (vev.sqlite-index-run-manifest-entity-attr-range-for-test (addr store) vaet-manifest 0 ":vaet" 1 ":item/friend")]
    (discard eavt-missing-first)
    (discard eavt-missing-last)
    (defer (remove-sqlite-files path))
    (t.is opened-ok opened-error)
    (t.is seed.ok seed.error)
    (t.is eavt-manifest-ok eavt-manifest-error)
    (t.is vaet-manifest-ok vaet-manifest-error)
    (t.is eavt-ok eavt-error)
    (t.is eavt-found)
    (t.is (>= eavt-first 0))
    (t.is (>= eavt-last eavt-first))
    (t.is eavt-missing-ok eavt-missing-error)
    (t.is (not eavt-missing-found))
    (t.is vaet-ok vaet-error)
    (t.is vaet-found)
    (t.is (>= vaet-first 0))
    (t.is (>= vaet-last vaet-first))
    (vev.delete-store-tx-report seed)
    (vev.close-store store)))

(t.deftest sqlite-bound-entity-multi-attr-query-uses-one-covering-scan
  (defer (free_all context.allocator))
  (remove-sqlite-files "tmp.vev.storage-multi-attr-scan.sqlite")
  (let [path "tmp.vev.storage-multi-attr-scan.sqlite"
        [store opened-ok opened-error] (vev.open-store path)
        seed (vev.transact-store-report-tx-data
               (addr store)
               ([]vev.Tx-Data [(vev.add 1 ":item/name" (vev.value-string "one"))
                                (vev.add 2 ":item/name" (vev.value-string "two"))
                                (vev.add 2 ":item/rank" (vev.value-int 20))
                                (vev.add 2 ":item/friend" (vev.value-entity 1))
                                (vev.add 3 ":item/friend" (vev.value-entity 1))]))
        [db db-ok db-error] (vev.store-db (addr store))]
    (defer (remove-sqlite-files path))
    (t.is opened-ok opened-error)
    (t.is seed.ok seed.error)
    (t.is db-ok db-error)
    (let [profiled (vev.q-profiled-store-db-text (addr db) "[:find ?name ?rank :where [?e :item/friend 1] [?e :item/name ?name] [?e :item/rank ?rank]]")]
      (t.is profiled.result.ok profiled.result.error)
      (t.is (= (count profiled.result.rows) 1))
      (t.is (= profiled.result.rows[0].values[0].kind .String))
      (t.is (= profiled.result.rows[0].values[0].text "two"))
      (t.is (= profiled.result.rows[0].values[1].kind .Int))
      (t.is (= profiled.result.rows[0].values[1].int-value 20))
      (t.is (= profiled.stats.clauses 3))
      (t.is (= profiled.stats.source-index-scans 2))
      (t.is (= profiled.stats.source-operators 2))
      (vev.delete-profiled-result-set-owned-values profiled))
    (vev.close-store-db! (addr db))
    (vev.delete-store-tx-report seed)
    (vev.close-store store)))

(t.deftest sqlite-reference-link-rule-feeds-multi-attr-projection
  (defer (free_all context.allocator))
  (remove-sqlite-files "tmp.vev.storage-reference-link-projection.sqlite")
  (let [path "tmp.vev.storage-reference-link-projection.sqlite"
        [store opened-ok opened-error] (vev.open-store path)
        seed (vev.transact-store-report-tx-data
               (addr store)
               ([]vev.Tx-Data [(vev.add 1 ":person/name" (vev.value-string "Ada"))
                                (vev.add 10 ":edge/left" (vev.value-entity 1))
                                (vev.add 20 ":edge/right" (vev.value-entity 10))
                                (vev.add 20 ":item/name" (vev.value-string "linked"))
                                (vev.add 20 ":item/rank" (vev.value-int 7))]))
        [db db-ok db-error] (vev.store-db (addr store))
        [source source-ok source-error] (vev.store-db-read-source (addr db))
        prepared (vev.prepare-query-text "[:find ?name ?rank :in $ % :where [?left :person/name \"Ada\"] (linked ?left ?right) [?right :item/name ?name] [?right :item/rank ?rank]]")
        prepared-rules (vev.parse-rules-text "[[(linked ?left ?right) [?middle :edge/left ?left] [?right :edge/right ?middle]]]")]
    (defer (remove-sqlite-files path))
    (t.is opened-ok opened-error)
    (t.is seed.ok seed.error)
    (t.is db-ok db-error)
    (t.is source-ok source-error)
    (t.is prepared.ok prepared.error)
    (t.is prepared-rules.ok prepared-rules.error)
    (let [profiled (vev.q-prepared-db-read-source-profiled-with-rules source prepared prepared-rules ([]vev.Query-Input []))]
      (t.is profiled.result.ok profiled.result.error)
      (t.is (= (count profiled.result.rows) 1))
      (t.is (= profiled.result.rows[0].values[0].kind .String))
      (t.is (= profiled.result.rows[0].values[0].text "linked"))
      (t.is (= profiled.result.rows[0].values[1].kind .Int))
      (t.is (= profiled.result.rows[0].values[1].int-value 7))
      (t.is (= profiled.stats.clauses 3))
      (t.is (= profiled.stats.source-index-scans 4))
      (t.is (= profiled.stats.source-operators 2))
      (t.is (= profiled.stats.rule-calls 1))
      (vev.delete-profiled-result-set-owned-values profiled))
    (vev.delete-prepared-query-shallow prepared)
    (vev.delete-prepared-rules-shallow prepared-rules)
    (vev.close-store-db! (addr db))
    (vev.delete-store-tx-report seed)
    (vev.close-store store)))

(t.deftest sqlite-bound-two-hop-same-entity-rule-uses-frontiers
  (defer (free_all context.allocator))
  (remove-sqlite-files "tmp.vev.storage-two-hop-same-entity-rule.sqlite")
  (let [path "tmp.vev.storage-two-hop-same-entity-rule.sqlite"
        [store opened-ok opened-error] (vev.open-store path)
        seed (vev.transact-store-report-tx-data
               (addr store)
               ([]vev.Tx-Data [(vev.add 100 ":db/ident" (vev.value-keyword ":track/artists"))
                                (vev.add 100 ":db/valueType" (vev.value-keyword ":db.type/ref"))
                                (vev.add 100 ":db/cardinality" (vev.value-keyword ":db.cardinality/many"))
                                (vev.add 1 ":artist/name" (vev.value-string "A"))
                                (vev.add 2 ":artist/name" (vev.value-string "B"))
                                (vev.add 3 ":artist/name" (vev.value-string "C"))
                                (vev.add 4 ":artist/name" (vev.value-string "D"))
                                (vev.add 10 ":track/artists" (vev.value-entity 1))
                                (vev.add 10 ":track/artists" (vev.value-entity 2))
                                (vev.add 11 ":track/artists" (vev.value-entity 2))
                                (vev.add 11 ":track/artists" (vev.value-entity 3))
                                (vev.add 12 ":track/artists" (vev.value-entity 1))
                                (vev.add 12 ":track/artists" (vev.value-entity 4))]))
        [db db-ok db-error] (vev.store-db (addr store))
        [source source-ok source-error] (vev.store-db-read-source (addr db))
        prepared (vev.prepare-query-text "[:find ?name :in $ % :where [?left :artist/name \"A\"] (net-2 :track/artists ?left ?right) [?right :artist/name ?name]]")
        prepared-rules (vev.parse-rules-text "[[(edge ?attr ?left ?right) [?entity ?attr ?left] [?entity ?attr ?right] [(!= ?left ?right)]] [(net-2 ?attr ?left ?right) (edge ?attr ?left ?right)] [(net-2 ?attr ?left ?right) (edge ?attr ?left ?middle) (edge ?attr ?middle ?right) [(!= ?left ?right)]]]")]
    (defer (remove-sqlite-files path))
    (t.is opened-ok opened-error)
    (t.is seed.ok seed.error)
    (t.is db-ok db-error)
    (t.is source-ok source-error)
    (t.is prepared.ok prepared.error)
    (t.is prepared-rules.ok prepared-rules.error)
    (let [profiled (vev.q-prepared-db-read-source-profiled-with-rules source prepared prepared-rules ([]vev.Query-Input []))
          found-b false
          found-c false
          found-d false]
      (t.is profiled.result.ok profiled.result.error)
      (t.is (= (count profiled.result.rows) 3))
      (for [row profiled.result.rows]
        (when (and (= (count row.values) 1)
                   (= row.values[0].kind .String))
          (cond
            (= row.values[0].text "B") (set! found-b true)
            (= row.values[0].text "C") (set! found-c true)
            (= row.values[0].text "D") (set! found-d true)
            :else (do))))
      (t.is found-b)
      (t.is found-c)
      (t.is found-d)
      (t.is (<= profiled.stats.source-index-scans 8))
      (vev.delete-profiled-result-set-owned-values profiled))
    (vev.delete-prepared-query-shallow prepared)
    (vev.delete-prepared-rules-shallow prepared-rules)
    (vev.close-store-db! (addr db))
    (vev.delete-store-tx-report seed)
    (vev.close-store store)))

(t.deftest sqlite-inlined-same-entity-ref-fanout-returns-only-result-frontier
  (defer (free_all context.allocator))
  (remove-sqlite-files "tmp.vev.storage-same-entity-ref-fanout.sqlite")
  (let [path "tmp.vev.storage-same-entity-ref-fanout.sqlite"
        [store opened-ok opened-error] (vev.open-store path)
        seed (vev.transact-store-report-tx-data
               (addr store)
               ([]vev.Tx-Data [(vev.add 100 ":db/ident" (vev.value-keyword ":track/artists"))
                                (vev.add 100 ":db/valueType" (vev.value-keyword ":db.type/ref"))
                                (vev.add 100 ":db/cardinality" (vev.value-keyword ":db.cardinality/many"))
                                (vev.add 1 ":artist/name" (vev.value-string "A"))
                                (vev.add 2 ":artist/name" (vev.value-string "B"))
                                (vev.add 3 ":artist/name" (vev.value-string "C"))
                                (vev.add 4 ":artist/name" (vev.value-string "D"))
                                (vev.add 10 ":track/artists" (vev.value-entity 1))
                                (vev.add 10 ":track/artists" (vev.value-entity 2))
                                (vev.add 11 ":track/artists" (vev.value-entity 2))
                                (vev.add 11 ":track/artists" (vev.value-entity 3))
                                (vev.add 12 ":track/artists" (vev.value-entity 1))
                                (vev.add 12 ":track/artists" (vev.value-entity 4))]))
        [db db-ok db-error] (vev.store-db (addr store))
        [source source-ok source-error] (vev.store-db-read-source (addr db))
        prepared (vev.prepare-query-text "[:find ?left-name ?right-name :in $ % [?left-name ...] :where (collab ?left-name ?right-name)]")
        nested (vev.prepare-query-text "[:find ?right-name :in $ % [[?left-name]] :where (collab ?left-name ?right-name)]")
        prepared-rules (vev.parse-rules-text "[[(edge ?attr ?left ?right) [?entity ?attr ?left] [?entity ?attr ?right] [(!= ?left ?right)]] [(collab ?left-name ?right-name) [?left :artist/name ?left-name] (edge :track/artists ?left ?right) [?right :artist/name ?right-name]]]")]
    (defer (remove-sqlite-files path))
    (t.is opened-ok opened-error)
    (t.is seed.ok seed.error)
    (t.is db-ok db-error)
    (t.is source-ok source-error)
    (t.is prepared.ok prepared.error)
    (t.is nested.ok nested.error)
    (t.is prepared-rules.ok prepared-rules.error)
    (let [profiled (vev.q-prepared-db-read-source-profiled-with-rules
                     source
                     prepared
                     prepared-rules
                     ([]vev.Query-Input [(vev.query-input-collection
                                           ([]vev.Value [(vev.value-string "A")
                                                          (vev.value-string "B")]))]))]
      (t.is profiled.result.ok profiled.result.error)
      (t.is (= (count profiled.result.rows) 4))
      (t.is (= profiled.stats.source-index-scans 1))
      (t.is (= profiled.stats.source-operators 1))
      (t.is (= profiled.stats.clause-candidates 4))
      (vev.delete-profiled-result-set-owned-values profiled))
    (let [profiled (vev.q-prepared-db-read-source-profiled-with-rules
                     source
                     nested
                     prepared-rules
                     ([]vev.Query-Input [(vev.query-input-relation
                                           ([]vev.Value [(vev.value-string "A")])
                                           1)]))]
      (t.is profiled.result.ok profiled.result.error)
      (t.is (= (count profiled.result.rows) 2))
      (t.is (= profiled.stats.source-index-scans 1))
      (t.is (= profiled.stats.clause-candidates 2))
      (vev.delete-profiled-result-set-owned-values profiled))
    (vev.delete-prepared-query-shallow prepared)
    (vev.delete-prepared-query-shallow nested)
    (vev.delete-prepared-rules-shallow prepared-rules)
    (vev.close-store-db! (addr db))
    (vev.delete-store-tx-report seed)
    (vev.close-store store)))

(t.deftest sqlite-correlated-fulltext-track-info-uses-joined-frontier
  (defer (free_all context.allocator))
  (remove-sqlite-files "tmp.vev.storage-fulltext-track-info.sqlite")
  (let [path "tmp.vev.storage-fulltext-track-info.sqlite"
        [store opened-ok opened-error] (vev.open-store path)
        schema (vev.transact-store-report-tx-data
                 (addr store)
                 ([]vev.Tx-Data [(vev.add 100 ":db/ident" (vev.value-keyword ":track/name"))
                                  (vev.add 100 ":db/valueType" (vev.value-keyword ":db.type/string"))
                                  (vev.add 100 ":db/cardinality" (vev.value-keyword ":db.cardinality/one"))
                                  (vev.add 100 ":db/fulltext" (vev.value-bool true))
                                  (vev.add 101 ":db/ident" (vev.value-keyword ":track/artists"))
                                  (vev.add 101 ":db/valueType" (vev.value-keyword ":db.type/ref"))
                                  (vev.add 101 ":db/cardinality" (vev.value-keyword ":db.cardinality/many"))
                                  (vev.add 102 ":db/ident" (vev.value-keyword ":artist/name"))
                                  (vev.add 102 ":db/valueType" (vev.value-keyword ":db.type/string"))
                                  (vev.add 103 ":db/ident" (vev.value-keyword ":medium/tracks"))
                                  (vev.add 103 ":db/valueType" (vev.value-keyword ":db.type/ref"))
                                  (vev.add 103 ":db/cardinality" (vev.value-keyword ":db.cardinality/many"))
                                  (vev.add 104 ":db/ident" (vev.value-keyword ":release/media"))
                                  (vev.add 104 ":db/valueType" (vev.value-keyword ":db.type/ref"))
                                  (vev.add 104 ":db/cardinality" (vev.value-keyword ":db.cardinality/many"))
                                  (vev.add 105 ":db/ident" (vev.value-keyword ":release/name"))
                                  (vev.add 105 ":db/valueType" (vev.value-keyword ":db.type/string"))
                                  (vev.add 106 ":db/ident" (vev.value-keyword ":release/year"))
                                  (vev.add 106 ":db/valueType" (vev.value-keyword ":db.type/long"))]))
        seed (vev.transact-store-report-tx-data
               (addr store)
               ([]vev.Tx-Data [(vev.add 1 ":artist/name" (vev.value-string "Example Artist"))
                                (vev.add 10 ":track/name" (vev.value-string "Always Here"))
                                (vev.add 10 ":track/artists" (vev.value-entity 1))
                                (vev.add 20 ":medium/tracks" (vev.value-entity 10))
                                (vev.add 30 ":release/media" (vev.value-entity 20))
                                (vev.add 30 ":release/name" (vev.value-string "Example Album"))
                                (vev.add 30 ":release/year" (vev.value-int 1971))]))
        ;; This test asserts the stable-checkpoint joined-frontier plan. The
        ;; preceding seed commit is otherwise intentionally left in the
        ;; bounded novelty tail, whose composed source has distinct counters.
        [_ compact-ok compact-error] (vev.compact-store-indexes! (addr store))
        [db db-ok db-error] (vev.store-db (addr store))
        [source source-ok source-error] (vev.store-db-read-source (addr db))
        prepared (vev.prepare-query-text "[:find ?title ?artist ?album ?year :in $ % ?search :where (track-search ?search ?track) (track-info ?track ?title ?artist ?album ?year)]")
        prepared-rules (vev.parse-rules-text "[[(track-release ?track ?release) [?medium :medium/tracks ?track] [?release :release/media ?medium]] [(track-info ?track ?title ?artist ?album ?year) [?track :track/name ?title] [?track :track/artists ?artist-entity] [?artist-entity :artist/name ?artist] (track-release ?track ?release) [?release :release/name ?album] [?release :release/year ?year]] [(track-search ?search ?track) [(fulltext $ :track/name ?search) [[?track ?matched-title]]]]]")]
    (defer (remove-sqlite-files path))
    (t.is opened-ok opened-error)
    (t.is schema.ok schema.error)
    (t.is seed.ok seed.error)
    (t.is compact-ok compact-error)
    (t.is db-ok db-error)
    (t.is source-ok source-error)
    (t.is prepared.ok prepared.error)
    (t.is prepared-rules.ok prepared-rules.error)
    (let [profiled (vev.q-prepared-db-read-source-profiled-with-rules
                     source
                     prepared
                     prepared-rules
                     ([]vev.Query-Input [(vev.query-input-scalar (vev.value-string "always"))]))]
      (t.is profiled.result.ok profiled.result.error)
      (t.is (= (count profiled.result.rows) 1))
      (t.is (= (count profiled.result.rows[0].values) 4))
      (t.is (= profiled.result.rows[0].values[0].text "Always Here"))
      (t.is (= profiled.result.rows[0].values[1].text "Example Artist"))
      (t.is (= profiled.result.rows[0].values[2].text "Example Album"))
      (t.is (= profiled.result.rows[0].values[3].int-value 1971))
      (t.is (= profiled.stats.source-index-scans 1))
      (t.is (= profiled.stats.source-operators 1))
      (t.is (= profiled.stats.clause-candidates 1))
      (vev.delete-profiled-result-set-owned-values profiled))
    (vev.delete-prepared-query-shallow prepared)
    (vev.delete-prepared-rules-shallow prepared-rules)
    (vev.close-store-db! (addr db))
    (vev.delete-store-tx-report seed)
    (vev.delete-store-tx-report schema)
    (vev.close-store store)))

(t.deftest sqlite-same-value-collaborator-query-uses-joined-frontier
  (defer (free_all context.allocator))
  (remove-sqlite-files "tmp.vev.storage-same-value-collaborator.sqlite")
  (let [path "tmp.vev.storage-same-value-collaborator.sqlite"
        [store opened-ok opened-error] (vev.open-store path)
        seed (vev.transact-store-report-tx-data
               (addr store)
               ([]vev.Tx-Data [(vev.add 100 ":db/ident" (vev.value-keyword ":track/artists"))
                                (vev.add 100 ":db/valueType" (vev.value-keyword ":db.type/ref"))
                                (vev.add 100 ":db/cardinality" (vev.value-keyword ":db.cardinality/many"))
                                (vev.add 1 ":artist/name" (vev.value-string "A"))
                                (vev.add 2 ":artist/name" (vev.value-string "B"))
                                (vev.add 3 ":artist/name" (vev.value-string "C"))
                                (vev.add 10 ":track/artists" (vev.value-entity 1))
                                (vev.add 10 ":track/name" (vev.value-string "Shared"))
                                (vev.add 11 ":track/artists" (vev.value-entity 2))
                                (vev.add 11 ":track/name" (vev.value-string "Shared"))
                                (vev.add 12 ":track/artists" (vev.value-entity 1))
                                (vev.add 12 ":track/name" (vev.value-string "Intro"))
                                (vev.add 13 ":track/artists" (vev.value-entity 3))
                                (vev.add 13 ":track/name" (vev.value-string "Intro"))]))
        [db db-ok db-error] (vev.store-db (addr store))
        [source source-ok source-error] (vev.store-db-read-source (addr db))
        prepared (vev.prepare-query-text "[:find ?other-name ?title :in $ ?name :where [?artist :artist/name ?name] [?track :track/artists ?artist] [?track :track/name ?title] [(!= \"Intro\" ?title)] [?other-track :track/name ?title] [?other-track :track/artists ?other-artist] [(!= ?other-artist ?artist)] [?other-artist :artist/name ?other-name]]")]
    (defer (remove-sqlite-files path))
    (t.is opened-ok opened-error)
    (t.is seed.ok seed.error)
    (t.is db-ok db-error)
    (t.is source-ok source-error)
    (t.is prepared.ok prepared.error)
    (let [profiled (vev.q-prepared-db-read-source-profiled-with-inputs
                     source
                     prepared
                     ([]vev.Query-Input [(vev.query-input-scalar (vev.value-string "A"))]))]
      (t.is profiled.result.ok profiled.result.error)
      (t.is (= (count profiled.result.rows) 1))
      (t.is (= profiled.result.rows[0].values[0].text "B"))
      (t.is (= profiled.result.rows[0].values[1].text "Shared"))
      (t.is (= profiled.stats.source-index-scans 1))
      (t.is (= profiled.stats.source-operators 1))
      (t.is (= profiled.stats.clause-candidates 1))
      (vev.delete-profiled-result-set-owned-values profiled))
    (vev.delete-prepared-query-shallow prepared)
    (vev.close-store-db! (addr db))
    (vev.delete-store-tx-report seed)
    (vev.close-store store)))

(t.deftest sqlite-track-release-rule-uses-joined-frontier
  (defer (free_all context.allocator))
  (remove-sqlite-files "tmp.vev.storage-track-release.sqlite")
  (let [path "tmp.vev.storage-track-release.sqlite"
        [store opened-ok opened-error] (vev.open-store path)
        seed (vev.transact-store-report-tx-data
               (addr store)
               ([]vev.Tx-Data [(vev.add 100 ":db/ident" (vev.value-keyword ":track/artists"))
                                (vev.add 100 ":db/valueType" (vev.value-keyword ":db.type/ref"))
                                (vev.add 101 ":db/ident" (vev.value-keyword ":medium/tracks"))
                                (vev.add 101 ":db/valueType" (vev.value-keyword ":db.type/ref"))
                                (vev.add 102 ":db/ident" (vev.value-keyword ":release/media"))
                                (vev.add 102 ":db/valueType" (vev.value-keyword ":db.type/ref"))
                                (vev.add 1 ":artist/name" (vev.value-string "A"))
                                (vev.add 10 ":track/artists" (vev.value-entity 1))
                                (vev.add 10 ":track/name" (vev.value-string "Track"))
                                (vev.add 20 ":medium/tracks" (vev.value-entity 10))
                                (vev.add 30 ":release/media" (vev.value-entity 20))
                                (vev.add 30 ":release/name" (vev.value-string "Album"))
                                (vev.add 30 ":release/year" (vev.value-int 1971))]))
        [db db-ok db-error] (vev.store-db (addr store))
        [source source-ok source-error] (vev.store-db-read-source (addr db))
        prepared (vev.prepare-query-text "[:find ?title ?album ?year :in $ % ?artist-name :where [?artist :artist/name ?artist-name] [?track :track/artists ?artist] [?track :track/name ?title] (track-release ?track ?release) [?release :release/name ?album] [?release :release/year ?year]]")
        prepared-rules (vev.parse-rules-text "[[(track-release ?track ?release) [?medium :medium/tracks ?track] [?release :release/media ?medium]]]")]
    (defer (remove-sqlite-files path))
    (t.is opened-ok opened-error)
    (t.is seed.ok seed.error)
    (t.is db-ok db-error)
    (t.is source-ok source-error)
    (t.is prepared.ok prepared.error)
    (t.is prepared-rules.ok prepared-rules.error)
    (let [profiled (vev.q-prepared-db-read-source-profiled-with-rules
                     source
                     prepared
                     prepared-rules
                     ([]vev.Query-Input [(vev.query-input-scalar (vev.value-string "A"))]))]
      (t.is profiled.result.ok profiled.result.error)
      (t.is (= (count profiled.result.rows) 1))
      (t.is (= profiled.result.rows[0].values[0].text "Track"))
      (t.is (= profiled.result.rows[0].values[1].text "Album"))
      (t.is (= profiled.result.rows[0].values[2].int-value 1971))
      (t.is (= profiled.stats.source-index-scans 1))
      (t.is (= profiled.stats.source-operators 1))
      (t.is (= profiled.stats.clause-candidates 1))
      (vev.delete-profiled-result-set-owned-values profiled))
    (vev.delete-prepared-query-shallow prepared)
    (vev.delete-prepared-rules-shallow prepared-rules)
    (vev.close-store-db! (addr db))
    (vev.delete-store-tx-report seed)
    (vev.close-store store)))

(t.deftest sqlite-collaboration-depth-two-dedupes-the-first-hop-frontier
  (defer (free_all context.allocator))
  (remove-sqlite-files "tmp.vev.storage-collaboration-depth-two.sqlite")
  (let [path "tmp.vev.storage-collaboration-depth-two.sqlite"
        [store opened-ok opened-error] (vev.open-store path)
        seed (vev.transact-store-report-tx-data
               (addr store)
               ([]vev.Tx-Data [(vev.add 100 ":db/ident" (vev.value-keyword ":track/artists"))
                                (vev.add 100 ":db/valueType" (vev.value-keyword ":db.type/ref"))
                                (vev.add 100 ":db/cardinality" (vev.value-keyword ":db.cardinality/many"))
                                (vev.add 1 ":artist/name" (vev.value-string "A"))
                                (vev.add 2 ":artist/name" (vev.value-string "B"))
                                (vev.add 3 ":artist/name" (vev.value-string "C"))
                                (vev.add 10 ":track/artists" (vev.value-entity 1))
                                (vev.add 10 ":track/artists" (vev.value-entity 2))
                                (vev.add 11 ":track/artists" (vev.value-entity 2))
                                (vev.add 11 ":track/artists" (vev.value-entity 3))]))
        [db db-ok db-error] (vev.store-db (addr store))
        [source source-ok source-error] (vev.store-db-read-source (addr db))
        prepared (vev.prepare-query-text "[:find ?name ?other-name :in $ % [?name ...] :where (collab-net-2 ?name ?other-name)]")
        prepared-rules (vev.parse-rules-text "[[(net-1 ?attr ?left ?right) [?entity ?attr ?left] [?entity ?attr ?right] [(!= ?left ?right)]] [(net-2 ?attr ?left ?right) (net-1 ?attr ?left ?right)] [(net-2 ?attr ?left ?right) (net-1 ?attr ?left ?middle) (net-1 ?attr ?middle ?right) [(!= ?left ?right)]] [(collab-net-2 ?name ?other-name) [?artist :artist/name ?name] (net-2 :track/artists ?artist ?other) [?other :artist/name ?other-name]]]")]
    (defer (remove-sqlite-files path))
    (t.is opened-ok opened-error)
    (t.is seed.ok seed.error)
    (t.is db-ok db-error)
    (t.is source-ok source-error)
    (t.is prepared.ok prepared.error)
    (t.is prepared-rules.ok prepared-rules.error)
    (let [profiled (vev.q-prepared-db-read-source-profiled-with-rules
                     source
                     prepared
                     prepared-rules
                     ([]vev.Query-Input [(vev.query-input-collection
                                           ([]vev.Value [(vev.value-string "A")]))]))]
      (t.is profiled.result.ok profiled.result.error)
      (t.is (= (count profiled.result.rows) 2))
      (let [found-b false
            found-c false]
        (for [row profiled.result.rows]
          (cond
            (= row.values[1].text "B") (set! found-b true)
            (= row.values[1].text "C") (set! found-c true)
            :else (do)))
        (t.is found-b)
        (t.is found-c))
      (t.is (= profiled.stats.source-index-scans 1))
      (t.is (= profiled.stats.source-operators 1))
      (t.is (= profiled.stats.clause-candidates 2))
      (vev.delete-profiled-result-set-owned-values profiled))
    (vev.delete-prepared-query-shallow prepared)
    (vev.delete-prepared-rules-shallow prepared-rules)
    (vev.close-store-db! (addr db))
    (vev.delete-store-tx-report seed)
    (vev.close-store store)))

