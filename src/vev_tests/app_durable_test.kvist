(package main)

(import os "core:os")
(import thread "core:thread")
(import test "kvist:test")
(import kdata "kvist:data")
(import d "../vev_app")

(def app-test-path "/tmp/vev-app-durable-test.sqlite")
(def concurrent-app-test-path "/tmp/vev-app-concurrent-test.sqlite")

(defstruct Concurrent-Reader {
  conn: d.Conn
  iterations: int
  ok: bool
})

(def concurrent-value-query
  '[:find ?value .
    :where [?e :entity/id "counter"]
           [?e :entity/value ?value]])

(defn concurrent-read-loop [reader: ^Concurrent-Reader]
  (let [remaining reader^.iterations]
    (while (> remaining 0)
      (let [db (d.db reader^.conn)
            value (d.q concurrent-value-query db)]
        (when (not (kdata.int? value))
          (set! reader^.ok false))
        (d.close db))
      (dec! remaining))))

(def ref-join-query
  '[:find ?workspace-id .
    :in $ ?project-id
    :where [?project :entity/id ?project-id]
           [?project :project/workspace ?workspace]
           [?workspace :entity/id ?workspace-id]])

(def collection-properties-query
  '[:find ?property-id ?label ?type ?order
    :in $ ?collection-id
    :where [?collection :entity/id ?collection-id]
           [?property :property/collection ?collection]
           [?property :entity/id ?property-id]
           [?property :property/label ?label]
           [?property :property/type ?type]
           [?property :property/order ?order]])

(defn remove-app-test-db []
  (os.remove app-test-path)
  (os.remove "/tmp/vev-app-durable-test.sqlite-wal")
  (os.remove "/tmp/vev-app-durable-test.sqlite-shm"))

(defn remove-concurrent-app-test-db []
  (os.remove concurrent-app-test-path)
  (os.remove "/tmp/vev-app-concurrent-test.sqlite-wal")
  (os.remove "/tmp/vev-app-concurrent-test.sqlite-shm"))

(test.deftest durable-app-query-input-joins-through-ref
  (remove-app-test-db)
  (let [conn (d.connect app-test-path)]
    (d.transact conn
      '[[:db/add 10 :db/ident :entity/id]
        [:db/add 10 :db/valueType :db.type/string]
        [:db/add 10 :db/unique :db.unique/identity]
        [:db/add 11 :db/ident :project/workspace]
        [:db/add 11 :db/valueType :db.type/ref]])
    (d.transact conn
      '[{:db/id "workspace" :entity/id "workspace-main"}])
    ;; Materialize and close a snapshot before the next transaction. Durable
    ;; connection reads must advance after a successful write.
    (let [before (d.db conn)
          workspace (d.q '[:find ?id .
                           :where [?e :entity/id ?id]] before)]
      (test.is (= (kdata.string workspace) "workspace-main"))
      (d.close before))
    (d.transact conn
      '[{:db/id "project"
         :entity/id "project-main"
         :project/workspace [:entity/id "workspace-main"]}])
    (let [db (d.db conn)
          project-with-input (d.q '[:find ?project .
                                     :in $ ?project-id
                                     :where [?project :entity/id ?project-id]] db "project-main")
          project-workspace-with-input (d.q '[:find ?workspace .
                                               :in $ ?project-id
                                               :where [?project :entity/id ?project-id]
                                                      [?project :project/workspace ?workspace]] db "project-main")
          result (d.q ref-join-query db "project-main")]
      (test.is (not (kdata.nil? project-with-input)))
      (test.is (not (kdata.nil? project-workspace-with-input)))
      (test.is (kdata.string? result))
      (test.is (= (kdata.string result) "workspace-main"))
      (d.close db))
    (d.close conn))
  (remove-app-test-db))

(test.deftest durable-app-query-projects-several-attributes-from-multiple-ref-children
  (remove-app-test-db)
  (let [conn (d.connect app-test-path)]
    (d.transact conn
      '[[:db/add 10 :db/ident :entity/id]
        [:db/add 10 :db/valueType :db.type/string]
        [:db/add 10 :db/unique :db.unique/identity]
        [:db/add 11 :db/ident :property/collection]
        [:db/add 11 :db/valueType :db.type/ref]
        [:db/add 12 :db/ident :property/label]
        [:db/add 12 :db/valueType :db.type/string]
        [:db/add 13 :db/ident :property/type]
        [:db/add 13 :db/valueType :db.type/keyword]
        [:db/add 14 :db/ident :property/order]
        [:db/add 14 :db/valueType :db.type/long]])
    (d.transact conn
      '[{:db/id "collection" :entity/id "collection-main"}
        {:db/id "first"
         :entity/id "property-first"
         :property/collection [:entity/id "collection-main"]
         :property/label "First"
         :property/type :property.type/text
         :property/order 0}
        {:db/id "second"
         :entity/id "property-second"
         :property/collection [:entity/id "collection-main"]
         :property/label "Second"
         :property/type :property.type/date
         :property/order 1}])
    (d.close conn))
  (let [reopened (d.connect app-test-path)]
    (let [db (d.db reopened)
          rows (d.q collection-properties-query db "collection-main")]
      (test.is (= (kdata.count rows) 2))
      (kdata.release rows)
      (d.close db))
    (d.close reopened))
  (remove-app-test-db))

(test.deftest durable-app-rejected-transaction-returns-a-report
  (remove-app-test-db)
  (let [conn (d.connect app-test-path)
        schema-report
        (d.transact conn
          '[[:db/add 10 :db/ident :entity/id]
            [:db/add 10 :db/valueType :db.type/string]
            [:db/add 10 :db/unique :db.unique/identity]
            [:db/add 11 :db/ident :entity/value]
            [:db/add 11 :db/valueType :db.type/long]])]
    (test.is schema-report.ok schema-report.error)
    ;; A schema mismatch is invalid user/application data, not a process-level
    ;; invariant failure.  The facade must expose the failed report rather than
    ;; panic before its caller can inspect it.
    (let [invalid-report
          (d.transact conn
            '[{:db/id "invalid" :entity/id "invalid" :entity/value "not-a-long"}])]
      (test.is (not invalid-report.ok))
      (test.is (= invalid-report.error "schema value type mismatch")))
    ;; Rejection is atomic and leaves the connection usable.
    (let [valid-report
          (d.transact conn
            '[{:db/id "valid" :entity/id "valid" :entity/value 42}])]
      (test.is valid-report.ok valid-report.error))
    (d.close conn))
  (remove-app-test-db))

(test.deftest durable-app-explicit-resident-mode-keeps-durable-reopen-semantics
  (remove-app-test-db)
  (let [seed (d.connect app-test-path)]
    (d.transact seed
      '[[:db/add 10 :db/ident :entity/id]
        [:db/add 10 :db/valueType :db.type/string]
        [:db/add 10 :db/unique :db.unique/identity]
        [:db/add 11 :db/ident :entity/value]
        [:db/add 11 :db/valueType :db.type/long]
        [:db/add 12 :db/ident :entity/link]
        [:db/add 12 :db/valueType :db.type/ref]
        {:db/id "counter" :entity/id "counter" :entity/value 1}])
    (d.close seed))
  (let [resident (d.connect app-test-path)
        [loaded loaded-error] (d.ensure-resident! resident)]
    (test.is loaded loaded-error)
    (let [before (d.db resident)
          before-value (d.q concurrent-value-query before)]
      (test.is (= (kdata.int before-value) 1))
      (d.close before))
    (let [report
            (d.transact resident
              '[[:db/add [:entity/id "counter"] :entity/value 2]])]
      (test.is report.ok report.error))
    ;; A resident connection is a normal connection, not a read cache. Each
    ;; committed transaction must immediately become the planning basis for
    ;; the next transaction, including lookup refs to newly allocated entities.
    (let [create-report
            (d.transact resident
              '[{:db/id "first-resident-entity"
                 :entity/id "first-resident-entity"
                 :entity/value 3
                 :entity/link [:entity/id "forward-resident-entity"]}
                {:db/id "forward-resident-entity"
                 :entity/id "forward-resident-entity"
                 :entity/value 5}])]
      (test.is create-report.ok create-report.error))
    (let [dependent-report
            (d.transact resident
              '[[:db/add [:entity/id "first-resident-entity"] :entity/value 4]])]
      (test.is dependent-report.ok dependent-report.error))
    (let [after (d.db resident)
          after-value (d.q concurrent-value-query after)
          dependent-value
            (d.q '[:find ?value .
                   :where [?e :entity/id "first-resident-entity"]
                          [?e :entity/value ?value]] after)]
      (test.is (= (kdata.int after-value) 2))
      (test.is (= (kdata.int dependent-value) 4))
      (d.close after))
    (d.close resident))
  ;; Resident mode changes only this connection's execution representation;
  ;; the ordinary durable log remains authoritative across a fresh process.
  (let [reopened (d.connect app-test-path)
        db (d.db reopened)
        value (d.q concurrent-value-query db)]
    (test.is (= (kdata.int value) 2))
    (d.close db)
    ;; A normal writer also detects the durable unindexed tail and continues
    ;; from it; resident mode must not create a file only resident callers can
    ;; safely advance.
    (let [continued
            (d.transact reopened
              '[[:db/add [:entity/id "counter"] :entity/value 6]])]
      (test.is continued.ok continued.error))
    (d.close reopened))
  (let [final (d.connect app-test-path)
        db (d.db final)
        value (d.q concurrent-value-query db)]
    (test.is (= (kdata.int value) 6))
    (d.close db)
    (d.close final))
  (remove-app-test-db))

(test.deftest durable-app-connection-serializes-concurrent-reads-and-writes
  (remove-concurrent-app-test-db)
  (let [conn (d.connect concurrent-app-test-path)]
    (d.transact conn
      '[[:db/add 10 :db/ident :entity/id]
        [:db/add 10 :db/valueType :db.type/string]
        [:db/add 10 :db/unique :db.unique/identity]
        [:db/add 11 :db/ident :entity/value]
        [:db/add 11 :db/valueType :db.type/long]])
    (d.transact conn
      '[{:db/id "counter" :entity/id "counter" :entity/value 0}])
    ;; Holding an immutable DB value must not block a later connection
    ;; transaction, and the held value must retain its original basis.
    (let [held (d.db conn)]
      (d.transact conn
        '[[:db/add [:entity/id "counter"] :entity/value 1]])
      (let [held-value (d.q concurrent-value-query held)]
        (test.is (= (kdata.int held-value) 0)))
      (d.close held))
    (let [reader (Concurrent-Reader {conn: conn iterations: 30 ok: true})
          worker (thread.create-and-start-with-poly-data (addr reader) concurrent-read-loop)
          index 0]
      (while (< index 30)
        (d.transact conn
          [[:db/add [:entity/id "counter"] :entity/value index]])
        (inc! index))
      (thread.join worker)
      (thread.destroy worker)
      (test.is reader.ok))
    (d.close conn))
  (remove-concurrent-app-test-db))
