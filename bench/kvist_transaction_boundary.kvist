  (print-phase database entities workload "report-edn-read" (slice samples.report-edn-read 0))
  (print-phase database entities workload "report-value-materialize" (slice samples.report-value-materialize 0)))

(defn run-workload
  [database: string, entities: int, workload: string, sample-count: int]
  (let [public-path (fmt.tprintf "tmp.vev.kvist-boundary.%s.%s.public.sqlite" database workload)
        native-path (fmt.tprintf "tmp.vev.kvist-boundary.%s.%s.native.sqlite" database workload)]
    (remove-sqlite-files public-path)
    (remove-sqlite-files native-path)
    (let [public-conn (d.connect public-path)
          [library library-ok] (native.load-default)]
      (when (not library-ok)
        (d.close public-conn)
        (panic "could not load native Vev library"))
      (let [[native-conn native-ok] (native.connect (addr library) native-path)]
        (when (not native-ok)
          (native.unload (addr library))
          (d.close public-conn)
          (panic "could not open native transaction boundary database"))
        (seed-public! public-conn entities)
        (seed-native! (addr native-conn) entities)
        (let [samples (empty-samples sample-count)]
          (for [sample (arr.range 0 sample-count)]
            (measure-public! (addr samples) public-conn workload sample)
            (measure-manual! (addr samples) (addr native-conn) workload sample))
          (for [sample (arr.range sample-count (* sample-count 2))]
            (measure-profile! (addr samples) (addr native-conn) workload sample))
          (print-samples database entities workload samples)
          (delete-samples (addr samples)))
        (native.close (addr native-conn)))
      (native.unload (addr library))
      (d.close public-conn))
    (remove-sqlite-files public-path)
    (remove-sqlite-files native-path)))

(defn run-ro-demo
  [public-path: string, native-path: string, sample-count: int]
  (when (= public-path native-path)
    (panic "--ro-public-db and --ro-native-db must be independent disposable copies"))
  (let [public-conn (d.connect public-path)
        [library library-ok] (native.load-default)]
    (when (not library-ok)
      (d.close public-conn)
      (panic "could not load native Vev library"))
    (let [[native-conn native-ok] (native.connect (addr library) native-path)]
      (when (not native-ok)
        (native.unload (addr library))
        (d.close public-conn)
        (panic "could not open native Ro demo database"))
      (when (not (d.ensure-resident! public-conn))
        (panic "could not make public Ro demo connection resident"))
      (when (not (native.ensure-resident (addr native-conn)))
        (panic "could not make native Ro demo connection resident"))
      (let [samples (empty-samples sample-count)]
        (for [sample (arr.range 0 sample-count)]
          (measure-public! (addr samples) public-conn "ro-demo" sample)
          (measure-manual! (addr samples) (addr native-conn) "ro-demo" sample))
        (for [sample (arr.range sample-count (* sample-count 2))]
          (measure-profile! (addr samples) (addr native-conn) "ro-demo" sample))
        (print-samples "ro-demo" 0 "ro-demo" samples)
        (delete-samples (addr samples)))
      (native.close (addr native-conn)))
    (native.unload (addr library))
    (d.close public-conn)))

(defn selected? [selected: string, value: string] -> bool
  (or (= selected "all") (= selected value)))

(defn main []
  (defer (free_all context.allocator))
  (let [selected-database (cli.option os.args "--database" "all")
        selected-workload (cli.option os.args "--workload" "all")
        ro-public-path (cli.option os.args "--ro-public-db" "")
        ro-native-path (cli.option os.args "--ro-native-db" "")
        sample-count (cli.int-option os.args "--samples" 30)]
    (for [database ([]string ["small" "large"])]
      (when (selected? selected-database database)
        (let [entities (if (= database "small") 50 2000)]
          (for [workload ([]string ["append" "replacement" "explicit-retract" "ro-like"])]
            (when (selected? selected-workload workload)
              (run-workload database entities workload sample-count))))))
    (when (or (> (count ro-public-path) 0) (> (count ro-native-path) 0))
      (when (or (= (count ro-public-path) 0) (= (count ro-native-path) 0))
        (panic "both --ro-public-db and --ro-native-db are required"))
      (run-ro-demo ro-public-path ro-native-path sample-count))))
