  edn-write: [dynamic]f64
  native-call: [dynamic]f64
  db-before-retain: [dynamic]f64
  db-after-retain: [dynamic]f64
  report-edn-write: [dynamic]f64
  report-edn-read: [dynamic]f64
  report-value-materialize: [dynamic]f64
  abi-input-copy: [dynamic]f64
  native-engine: [dynamic]f64
  native-report-handle: [dynamic]f64
  native-listener: [dynamic]f64
  native-cleanup: [dynamic]f64
  parsing: [dynamic]f64
  resolution: [dynamic]f64
  resolution-lookup-ref: [dynamic]f64
  resolution-ident: [dynamic]f64
  resolution-tempid: [dynamic]f64
  resolution-op-generation: [dynamic]f64
  resolution-lookup-ref-count: [dynamic]f64
  resolution-ident-count: [dynamic]f64
  resolution-tempid-count: [dynamic]f64
  resolution-current-tx-count: [dynamic]f64
  resolution-generated-op-count: [dynamic]f64
  validation: [dynamic]f64
  planning: [dynamic]f64
  planning-current-fact: [dynamic]f64
  planning-schema: [dynamic]f64
  planning-cardinality: [dynamic]f64
  planning-unique: [dynamic]f64
  planning-normalization: [dynamic]f64
