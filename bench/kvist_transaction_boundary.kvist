    manual-total: (make [dynamic]f64 0 capacity)
    edn-write: (make [dynamic]f64 0 capacity)
    native-call: (make [dynamic]f64 0 capacity)
    db-before-retain: (make [dynamic]f64 0 capacity)
    db-after-retain: (make [dynamic]f64 0 capacity)
    report-edn-write: (make [dynamic]f64 0 capacity)
    report-edn-read: (make [dynamic]f64 0 capacity)
    report-value-materialize: (make [dynamic]f64 0 capacity)
    abi-input-copy: (make [dynamic]f64 0 capacity)
    native-engine: (make [dynamic]f64 0 capacity)
    native-report-handle: (make [dynamic]f64 0 capacity)
    native-listener: (make [dynamic]f64 0 capacity)
    native-cleanup: (make [dynamic]f64 0 capacity)
    parsing: (make [dynamic]f64 0 capacity)
    resolution: (make [dynamic]f64 0 capacity)
    resolution-lookup-ref: (make [dynamic]f64 0 capacity)
    resolution-ident: (make [dynamic]f64 0 capacity)
    resolution-tempid: (make [dynamic]f64 0 capacity)
    resolution-op-generation: (make [dynamic]f64 0 capacity)
    resolution-lookup-ref-count: (make [dynamic]f64 0 capacity)
    resolution-ident-count: (make [dynamic]f64 0 capacity)
    resolution-tempid-count: (make [dynamic]f64 0 capacity)
    resolution-current-tx-count: (make [dynamic]f64 0 capacity)
    resolution-generated-op-count: (make [dynamic]f64 0 capacity)
    validation: (make [dynamic]f64 0 capacity)
    planning: (make [dynamic]f64 0 capacity)
    planning-current-fact: (make [dynamic]f64 0 capacity)
    planning-schema: (make [dynamic]f64 0 capacity)
    planning-cardinality: (make [dynamic]f64 0 capacity)
